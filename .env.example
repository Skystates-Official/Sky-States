# Site
SITE_URL=https://skystates.us

# Whop Payment Gateway (https://whop.com)
# Option 1: Direct Whop Hosted Checkout Link (Recommended & Easiest)
# Create a checkout link in Whop Dashboard -> Checkout Links / Products
WHOP_CHECKOUT_URL=https://whop.com/checkout/your_plan_or_product_id
# Optional: separate checkout links for registration vs full program
# WHOP_CHECKOUT_URL_REGISTRATION=https://whop.com/checkout/plan_registration_id
# WHOP_CHECKOUT_URL_FULL=https://whop.com/checkout/plan_full_id

# Option 2: Whop API (Whop Dashboard -> Developer -> API Keys)
# WHOP_API_KEY=your_whop_api_key
# WHOP_ACCOUNT_ID=biz_your_account_id
# Intro Session ($99 & $499)
# WHOP_PLAN_ID_REGISTRATION=plan_your_99_plan
# WHOP_PLAN_ID_REGISTRATION_1ON1=plan_your_499_plan
# Full Program ($3,499 & $6,499)
# WHOP_PLAN_ID_FULL=plan_your_3499_plan
# WHOP_PLAN_ID_FULL_1ON1=plan_your_6499_plan

# Whop Webhook (Whop Dashboard -> Developer -> Webhooks)
# Endpoint URL: https://skystates.us/api/payments/webhook
# Events: payment.succeeded, checkout.session.completed
WHOP_WEBHOOK_SECRET=ws_your_whop_webhook_secret

# Stripe (COMMENTED OUT - Currently disabled)
# STRIPE_SECRET_KEY=sk_live_your_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin session signing (change in production)
SESSION_SECRET=change_me_to_a_long_random_string

# Super admin account — synced on every container start
ADMIN_USERNAME=support@skystates.us
ADMIN_PASSWORD=your_secure_password

# Email — Hostinger (support@skystates.us)
# hPanel → Emails → Manage → Configuration settings
# DNS: hPanel → Emails → Manage → Domain settings → Connect Domain
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@skystates.us
SMTP_PASS=your_email_account_password
SMTP_FROM=Sky States <support@skystates.us>
SMTP_REPLY_TO=support@skystates.us
