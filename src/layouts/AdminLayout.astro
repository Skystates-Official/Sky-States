---
import '../styles/global.css';
const { title = "Admin Portal" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Admin Portal</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- Feather Icons -->
  <script src="https://unpkg.com/feather-icons"></script>
</head>
<body class="bg-surface-container text-on-surface font-body-md min-h-screen hidden" id="admin-body">
  
  <!-- Sidebar -->
  <aside class="w-64 bg-surface border-r border-outline-variant hidden md:flex flex-col sticky top-0 h-screen shrink-0">
    <div class="h-16 flex items-center px-6 border-b border-outline-variant">
      <span class="font-headline-md text-primary font-bold">SkyStates Admin</span>
    </div>
    
    <nav class="flex-1 overflow-y-auto py-4">
      <ul class="space-y-1 px-3">
        <li>
          <a href="/admin/dashboard" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface hover:bg-surface-container-high transition-colors">
            <i data-feather="grid" class="w-5 h-5 text-on-surface-variant"></i>
            <span class="font-label-md">Dashboard</span>
          </a>
        </li>
        <li>
          <a href="/admin/blogs" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface hover:bg-surface-container-high transition-colors">
            <i data-feather="edit-3" class="w-5 h-5 text-on-surface-variant"></i>
            <span class="font-label-md">Content Studio</span>
          </a>
        </li>
        <li>
          <a href="/admin/media" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface hover:bg-surface-container-high transition-colors">
            <i data-feather="image" class="w-5 h-5 text-on-surface-variant"></i>
            <span class="font-label-md">Media Vault</span>
          </a>
        </li>
        <li>
          <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-on-surface hover:bg-surface-container-high transition-colors">
            <i data-feather="settings" class="w-5 h-5 text-on-surface-variant"></i>
            <span class="font-label-md">System Settings</span>
          </a>
        </li>
      </ul>
    </nav>
    
    <div class="p-4 border-t border-outline-variant">
      <button id="logout-btn" class="w-full flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-error hover:bg-error-container hover:text-on-error-container transition-colors font-label-md">
        <i data-feather="log-out" class="w-4 h-4"></i>
        Logout
      </button>
    </div>
  </aside>

  <!-- Mobile Header -->
  <div class="md:hidden fixed top-0 left-0 right-0 h-16 bg-surface border-b border-outline-variant flex items-center justify-between px-4 z-50">
     <span class="font-headline-md text-primary font-bold">SkyStates</span>
     <button id="mobile-menu-btn" class="p-2 text-on-surface-variant">
       <i data-feather="menu"></i>
     </button>
  </div>

  <!-- Main Content Area -->
  <main class="flex-1 flex flex-col min-w-0 h-screen overflow-hidden pt-16 md:pt-0">
    <!-- Top Header -->
    <header class="h-16 bg-surface border-b border-outline-variant hidden md:flex items-center justify-end px-6 shrink-0 sticky top-0 z-40">
       <div class="flex items-center gap-4">
         <button class="p-2 text-on-surface-variant hover:bg-surface-container-high rounded-full relative">
           <i data-feather="bell" class="w-5 h-5"></i>
           <span class="absolute top-1 right-1 w-2 h-2 bg-error rounded-full hidden" id="notification-dot"></span>
         </button>
         <div class="w-8 h-8 rounded-full bg-primary-container text-on-primary-container flex items-center justify-center font-bold text-sm" id="user-avatar">
           A
         </div>
       </div>
    </header>

    <!-- Page Content -->
    <div class="flex-1 overflow-y-auto p-4 md:p-8 bg-surface-container-lowest">
      <div class="max-w-7xl mx-auto">
        <slot />
      </div>
    </div>
  </main>

  <script>
    declare const feather: any;
    
    // Initialize Feather Icons
    // Note: Since Astro might navigate without full reload, we ensure icons run.
    document.addEventListener('DOMContentLoaded', () => {
       if (typeof feather !== 'undefined') feather.replace();
    });

    // Auth Middleware & Init
    async function initAdmin() {
      try {
        const res = await fetch('/api/auth/me');
        if (!res.ok) {
          window.location.href = '/admin/login';
          return;
        }
        const user = await res.json();
        
        // Show body now that auth is confirmed to prevent unauthenticated flash
        document.getElementById('admin-body')?.classList.remove('hidden');
        document.getElementById('admin-body')?.classList.add('flex');
        
        const avatar = document.getElementById('user-avatar');
        if (avatar) avatar.textContent = user.username ? user.username.charAt(0).toUpperCase() : 'U';

        // Check for unread notifications
        const notifRes = await fetch('/api/notifications?unread=true');
        if (notifRes.ok) {
           const notifications = await notifRes.json();
           if (notifications.length > 0) {
              document.getElementById('notification-dot')?.classList.remove('hidden');
           }
        }
      } catch (err) {
        window.location.href = '/admin/login';
      }
    }

    initAdmin();

    // Logout
    document.getElementById('logout-btn')?.addEventListener('click', async () => {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/admin/login';
    });
  </script>
</body>
</html>
