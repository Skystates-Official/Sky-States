---
import '../../styles/global.css';
---

<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Forgot Password | SkyStates Admin</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/feather-icons"></script>
</head>
<body class="bg-surface-container-lowest text-on-surface font-body-md min-h-screen flex items-center justify-center p-4" style="background-image: radial-gradient(var(--primary-container) 1px, transparent 1px); background-size: 32px 32px; background-color: var(--surface-container-lowest);">
  
  <div class="w-full max-w-md bg-surface p-8 rounded-xl shadow-lg border border-outline-variant relative overflow-hidden">
    <div class="absolute top-0 left-0 right-0 h-2 bg-primary"></div>
    
    <div class="text-center mb-8 mt-2">
      <div class="w-12 h-12 bg-primary-container text-on-primary-container rounded-full flex items-center justify-center mx-auto mb-4">
         <i data-feather="key" class="w-6 h-6"></i>
      </div>
      <h1 class="font-headline-md text-on-surface mb-2">Reset Password</h1>
      <p class="text-on-surface-variant font-body-md text-sm">Enter your email address and we'll send you a link to reset your password.</p>
    </div>

    <form id="forgot-form" class="space-y-6">
      <div id="status-message" class="hidden px-4 py-3 rounded-lg font-label-md text-center text-sm"></div>

      <div class="space-y-2">
        <label for="email" class="block font-label-sm text-on-surface">Email Address</label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i data-feather="mail" class="w-5 h-5 text-on-surface-variant"></i>
          </div>
          <input type="email" id="email" name="email" required 
            class="block w-full pl-10 pr-3 py-2.5 border border-outline bg-surface rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-on-surface placeholder-on-surface-variant transition-shadow" 
            placeholder="admin@skystates.us">
        </div>
      </div>

      <button type="submit" id="submit-btn" class="w-full bg-primary hover:bg-primary-fixed text-on-primary hover:text-on-primary-fixed-variant font-label-md py-3 rounded-lg transition-colors shadow-sm">
        Send Reset Link
      </button>

      <div class="text-center">
         <a href="/admin/login" class="font-label-sm text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center gap-1">
           <i data-feather="arrow-left" class="w-4 h-4"></i> Back to Login
         </a>
      </div>
    </form>
  </div>

  <script>
    declare const feather: any;
    
    document.getElementById('forgot-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const statusDiv = document.getElementById('status-message')!;
      const btn = document.getElementById('submit-btn') as HTMLButtonElement;
      
      (btn as any).disabled = true;
      const btnText = btn!.innerHTML;
      btn.innerHTML = `<i data-feather="loader" class="animate-spin mr-2"></i> Sending...`;
      if (typeof feather !== 'undefined') feather.replace();

      try {
        const res = await fetch('/api/auth/forgot-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });
        
        statusDiv.classList.remove('hidden', 'bg-error-container', 'text-on-error-container');
        statusDiv.classList.add('bg-primary-container', 'text-on-primary-container');
        statusDiv.textContent = 'If an account exists, a reset link will be sent.';
        (document.getElementById('email') as HTMLInputElement).value = '';
        
      } catch (err) {
        statusDiv.classList.remove('hidden', 'bg-primary-container', 'text-on-primary-container');
        statusDiv.classList.add('bg-error-container', 'text-on-error-container');
        statusDiv.textContent = 'An error occurred. Please try again later.';
      } finally {
        (btn as any).disabled = false;
        btn!.innerHTML = btnText;
        if (typeof feather !== 'undefined') feather.replace();
      }
    });
  </script>
</body>
</html>
