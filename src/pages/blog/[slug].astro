---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getBlog } from "../../lib/blogs.js";

export const prerender = false;

const { slug } = Astro.params;

const blog = slug ? await getBlog(slug) : null;

if (!blog || blog.status !== "published") {
  return Astro.redirect("/blog");
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{blog.title}</title>

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />
  </head>

  <body>
    <Header />

    <main class="single-blog-page">
      <section class="single-blog">
        <div class="blog-wrapper">
          <header class="blog-header">
            <div class="blog-category">
              {blog.category}
            </div>

            <h1>
              {blog.title}
            </h1>

            <div class="blog-meta">
              <span>
                {
                  new Date(blog.created_at).toLocaleDateString("en-US", {
                    day: "numeric",
                    month: "short",
                    year: "numeric",
                  })
                }
              </span>
            </div>
          </header>

          {
            blog.image && (
              <figure class="blog-feature-image">
                <img src={blog.image} alt={blog.title} loading="lazy" />
              </figure>
            )
          }

          <article class="blog-content">
            <p class="short-description">
              {blog.short_description}
            </p>

            <div class="content" set:html={blog.content} />
          </article>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .single-blog-page {
    width: 100%;
    background: #ffffff;
    padding-top: 90px;
  }

  /* Main Container */

  .single-blog {
    width: 100%;
    padding: 60px 25px 100px;
  }

  .blog-wrapper {
    max-width: 1180px;
    margin: auto;
  }

  /* Header */

  .blog-header {
    max-width: 950px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .blog-category {
    display: inline-flex;
    align-items: center;

    background: #0071ad;

    color: #ffffff;

    padding: 8px 20px;

    border-radius: 50px;

    font-size: 13px;

    font-weight: 700;

    letter-spacing: 0.5px;

    text-transform: uppercase;

    margin-bottom: 25px;
  }

  .blog-header h1 {
    font-size: 52px;

    line-height: 1.15;

    font-weight: 800;

    letter-spacing: -1.2px;

    color: #0f172a;

    margin: 0 auto;
  }

  .blog-meta {
    display: flex;

    justify-content: center;

    gap: 15px;

    margin-top: 25px;

    color: #64748b;

    font-size: 15px;
  }

  /* Featured Image */

  .blog-feature-image {
    width: 100%;

    margin: 0 auto 60px;
  }

  .blog-feature-image img {
    width: 100%;

    height: 560px;

    object-fit: cover;

    border-radius: 28px;

    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.15);
  }

  /* Article */

  .blog-content {
    max-width: 900px;

    margin: auto;
  }

  .short-description {
    font-size: 22px;

    line-height: 1.8;

    color: #334155;

    font-weight: 500;

    padding-bottom: 35px;

    border-bottom: 1px solid #e2e8f0;

    margin-bottom: 45px;
  }

  /* Responsive shell */

  @media (max-width: 900px) {
    .blog-header h1 {
      font-size: 38px;
    }

    .blog-feature-image img {
      height: 400px;
    }
  }

  @media (max-width: 600px) {
    .single-blog {
      padding: 40px 15px 70px;
    }

    .blog-header h1 {
      font-size: 30px;
    }

    .blog-feature-image img {
      height: 250px;

      border-radius: 18px;
    }

    .short-description {
      font-size: 18px;
    }
  }
</style>

<!-- Global styles so TinyMCE HTML (set:html) is styled correctly -->
<style is:global>
  .single-blog-page .content {
    font-size: 18px;
    line-height: 1.9;
    color: #334155;
  }

  .single-blog-page .content p {
    margin-bottom: 28px;
  }

  .single-blog-page .content h2 {
    margin-top: 55px;
    margin-bottom: 22px;
    font-size: 34px;
    line-height: 1.3;
    font-weight: 750;
    color: #0f172a;
  }

  .single-blog-page .content h3 {
    margin-top: 40px;
    margin-bottom: 18px;
    font-size: 26px;
    font-weight: 700;
    color: #0f172a;
  }

  .single-blog-page .content h4 {
    font-size: 22px;
    margin-top: 30px;
    color: #0f172a;
  }

  .single-blog-page .content ul,
  .single-blog-page .content ol {
    margin: 25px 0;
    padding-left: 35px;
  }

  .single-blog-page .content li {
    margin-bottom: 12px;
  }

  .single-blog-page .content a {
    color: #0071ad;
    font-weight: 600;
    text-decoration: none;
  }

  .single-blog-page .content a:hover {
    text-decoration: underline;
  }

  .single-blog-page .content img {
    width: 100%;
    max-width: 100%;
    border-radius: 18px;
    margin: 35px 0;
  }

  .single-blog-page .content blockquote {
    margin: 35px 0;
    padding: 25px 30px;
    background: #f0f9ff;
    border-left: 5px solid #0071ad;
    border-radius: 10px;
    font-size: 20px;
    font-style: italic;
    color: #334155;
  }

  .single-blog-page .content pre {
    background: #0f172a;
    color: #ffffff;
    padding: 25px;
    border-radius: 15px;
    overflow-x: auto;
    margin: 30px 0;
  }

  .single-blog-page .content code {
    font-family: "Fira Code", monospace;
  }

  .single-blog-page .content table {
    width: 100%;
    border-collapse: collapse;
    margin: 35px 0;
  }

  .single-blog-page .content th {
    background: #f1f5f9;
    font-weight: 700;
  }

  .single-blog-page .content th,
  .single-blog-page .content td {
    border: 1px solid #e2e8f0;
    padding: 14px;
    text-align: left;
  }

  .single-blog-page .content strong {
    color: #0f172a;
    font-weight: 700;
  }

  .single-blog-page .content hr {
    border: none;
    border-top: 1px solid #e2e8f0;
    margin: 45px 0;
  }

  @media (max-width: 900px) {
    .single-blog-page .content {
      font-size: 17px;
    }
  }

  @media (max-width: 600px) {
    .single-blog-page .content {
      font-size: 16px;
    }

    .single-blog-page .content h2 {
      font-size: 27px;
    }

    .single-blog-page .content h3 {
      font-size: 22px;
    }
  }
</style>
