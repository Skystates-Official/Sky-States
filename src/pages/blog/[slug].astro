
---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getBlog } from "../../lib/blogs.js";

export const prerender = false;

const { slug } = Astro.params;

const blog = slug ? await getBlog(slug) : null;

if (!blog) {
    return Astro.redirect("/blog");
}

/* ==================================================
   SEO
================================================== */

const siteUrl = "https://skystates.us";

const canonicalUrl =
    blog.canonical || `${siteUrl}/blog/${blog.slug}`;

const seoTitle =
    blog.seo_title || blog.title;

const seoDescription =
    blog.seo_description ||
    blog.short_description ||
    "";

const publishDate = blog.created_at
    ? new Date(blog.created_at).toISOString()
    : new Date().toISOString();

const modifiedDate = blog.updated_at
    ? new Date(blog.updated_at).toISOString()
    : publishDate;


/* ==================================================
   IMAGE URL
   Supports:
   JPG
   JPEG
   PNG
   WEBP
   GIF
   SVG
   Absolute URLs
================================================== */

const imageUrl = blog.image
    ? blog.image.startsWith("http")
        ? blog.image
        : blog.image.startsWith("/")
            ? blog.image
            : `/${blog.image}`
    : "/default-blog-image.jpg";


const authorName =
    blog.author || "Sky States";
---

<!doctype html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
        name="description"
        content={seoDescription}
    />

    <meta
        name="keywords"
        content={blog.keywords || ""}
    />

    <link
        rel="canonical"
        href={canonicalUrl}
    />


    <!-- ==================================================
         OPEN GRAPH
    ================================================== -->

    <meta
        property="og:type"
        content="article"
    />

    <meta
        property="og:title"
        content={seoTitle}
    />

    <meta
        property="og:description"
        content={seoDescription}
    />

    <meta
        property="og:url"
        content={canonicalUrl}
    />

    <meta
        property="og:image"
        content={imageUrl}
    />

    <meta
        property="article:published_time"
        content={publishDate}
    />

    <meta
        property="article:modified_time"
        content={modifiedDate}
    />

    <meta
        property="article:section"
        content={blog.category || ""}
    />

    <meta
        property="article:author"
        content={authorName}
    />


    <!-- ==================================================
         TWITTER
    ================================================== -->

    <meta
        name="twitter:card"
        content="summary_large_image"
    />

    <meta
        name="twitter:title"
        content={seoTitle}
    />

    <meta
        name="twitter:description"
        content={seoDescription}
    />

    <meta
        name="twitter:image"
        content={imageUrl}
    />


    <!-- ==================================================
         MATERIAL SYMBOLS
    ================================================== -->

    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />


    <!-- ==================================================
         ARTICLE SCHEMA
    ================================================== -->

    <script type="application/ld+json">
        {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Article",

            headline: blog.title,

            description: seoDescription,

            image: [
                imageUrl
            ],

            author: {
                "@type": "Person",
                name: authorName
            },

            publisher: {
                "@type": "Organization",
                name: "Sky States",
                url: siteUrl,

                logo: {
                    "@type": "ImageObject",
                    url: `${siteUrl}/logo.png`
                }
            },

            datePublished: publishDate,

            dateModified: modifiedDate,

            mainEntityOfPage: {
                "@type": "WebPage",
                "@id": canonicalUrl
            },

            articleSection:
                blog.category || "",

            keywords:
                blog.keywords || ""
        })}
    </script>

</head>


<body>

    <Header />


    <!-- ==================================================
         BLOG PAGE
    ================================================== -->

    <main class="blog-page">

        <div class="blog-container">

            <article
                class="blog-article"
                itemscope
                itemtype="https://schema.org/Article"
            >


                <!-- ==================================================
                     BLOG HEADER
                ================================================== -->

                <header class="blog-header">

                    {blog.category && (

                        <div
                            class="blog-category"
                            itemprop="articleSection"
                        >
                            {blog.category}
                        </div>

                    )}


                    <h1
                        class="blog-title"
                        itemprop="headline"
                    >
                        {blog.title}
                    </h1>


                    <!-- ==================================================
                         BLOG META
                    ================================================== -->

                    <div class="blog-meta">

                        <span>

                            By

                            <strong>
                                {authorName}
                            </strong>

                        </span>


                        <span class="separator">
                            •
                        </span>


                        <time
                            datetime={publishDate}
                            itemprop="datePublished"
                        >

                            {new Date(
                                blog.created_at
                            ).toLocaleDateString(
                                "en-US",
                                {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric"
                                }
                            )}

                        </time>

                    </div>

                </header>


                <!-- ==================================================
                     FEATURED IMAGE
                     
                     SAME SIZE AS YOUR ORIGINAL VERSION
                ================================================== -->

                {blog.image && (

                    <img
                        class="blog-featured-image"
                        src={imageUrl}
                        alt={blog.title}
                        title={blog.title}
                        width="1200"
                        height="675"
                        loading="eager"
                        fetchpriority="high"
                        itemprop="image"
                    />

                )}


                <!-- ==================================================
                     SHORT DESCRIPTION
                ================================================== -->

                {blog.short_description && (

                    <div
                        class="blog-description"
                        itemprop="description"
                    >
                        {blog.short_description}
                    </div>

                )}


                <!-- ==================================================
                     BLOG CONTENT
                ================================================== -->

                <div
                    class="blog-content"
                    itemprop="articleBody"
                    set:html={blog.content}
                ></div>


            </article>

        </div>

    </main>


    <Footer />


    <!-- ==================================================
         PAGE CSS
    ================================================== -->

    <style>

        /* ==================================================
           BLOG PAGE
        ================================================== */


    /* =========================================================
       BLOG PAGE
    ========================================================= */

    .blog-page {
        width: 100%;
        min-height: 100vh;
        padding: 55px 20px 90px;
        box-sizing: border-box;

        background: linear-gradient(
            180deg,
            #f8fafc 0%,
            #eef2f7 100%
        );
    }

    .blog-container {
        width: 100%;
        max-width: 1180px;
        margin: 0 auto;
        box-sizing: border-box;
    }

    /* =========================================================
       ARTICLE
    ========================================================= */

    .blog-article {
        width: 100%;
        overflow: hidden;
        box-sizing: border-box;

        background: #ffffff;

        border: 1px solid #e5e7eb;
        border-radius: 24px;

        box-shadow:
            0 10px 30px rgba(15, 23, 42, 0.06),
            0 30px 70px rgba(15, 23, 42, 0.05);
    }

    /* =========================================================
       BLOG HEADER
    ========================================================= */

    .blog-header {
        width: 100%;
        max-width: 950px;

        margin: 0 auto;
        padding: 55px 40px 35px;

        box-sizing: border-box;
        text-align: center;
    }

    /* =========================================================
       CATEGORY
    ========================================================= */

    .blog-category {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 20px;
        padding: 7px 16px;

        border: 1px solid #dbeafe;
        border-radius: 50px;

        background: #eff6ff;
        color: #2563eb;

        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.7px;
        text-transform: uppercase;
    }

    /* =========================================================
       TITLE
    ========================================================= */

    .blog-title {
        margin: 0;

        color: #111827;

        font-size: clamp(32px, 4vw, 54px);
        line-height: 1.12;
        font-weight: 800;

        letter-spacing: -1.8px;

        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /* =========================================================
       META
    ========================================================= */

    .blog-meta {
        display: flex;
        align-items: center;
        justify-content: center;

        flex-wrap: wrap;
        gap: 10px;

        margin-top: 24px;

        color: #6b7280;
        font-size: 15px;
    }

    .blog-meta strong {
        color: #374151;
        font-weight: 600;
    }

    .separator {
        color: #cbd5e1;
    }

    /* =========================================================
       FEATURED IMAGE
       
       DESKTOP TARGET:
       Width  : 950px
       Height : 560px

       Responsive:
       Desktop  -> up to 950 x 560
       Tablet   -> scales down automatically
       Mobile   -> width 100%, height auto
    ========================================================= */

    .blog-featured-image {
        display: block;

        width: min(950px, calc(100% - 40px));
        height: 560px;

        margin: 0 auto;

        object-fit: cover;

        border-radius: 18px;

        padding: 0;

        box-sizing: border-box;

        max-width: 100%;
    }

    /* =========================================================
       SHORT DESCRIPTION
    ========================================================= */

    .blog-description {
        width: 100%;
        max-width: 850px;

        margin: 38px auto 0;
        padding: 0 30px;

        box-sizing: border-box;

        color: #4b5563;

        font-size: 19px;
        line-height: 1.75;

        text-align: center;

        overflow-wrap: anywhere;
        word-break: break-word;
    }

    /* =========================================================
       BLOG CONTENT
    ========================================================= */

    .blog-content {
        width: 100%;
        max-width: 850px;

        margin: 45px auto 0;
        padding: 0 30px 75px;

        box-sizing: border-box;

        color: #1f2937;

        font-size: 17px;
        line-height: 1.85;

        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .blog-content p {
        margin: 0 0 24px;
    }

    /* =========================================================
       HEADINGS
    ========================================================= */

    .blog-content h2 {
        margin: 50px 0 18px;

        color: #111827;

        font-size: 30px;
        line-height: 1.3;
        font-weight: 750;

        overflow-wrap: anywhere;
    }

    .blog-content h3 {
        margin: 38px 0 15px;

        color: #111827;

        font-size: 24px;
        line-height: 1.4;
        font-weight: 700;

        overflow-wrap: anywhere;
    }

    .blog-content h4 {
        margin: 30px 0 12px;

        color: #111827;

        font-size: 20px;

        overflow-wrap: anywhere;
    }

    /* =========================================================
       LINKS
    ========================================================= */

    .blog-content a {
        color: #2563eb;
        font-weight: 600;

        text-decoration: none;

        overflow-wrap: anywhere;
        word-break: break-word;

        transition: 0.2s ease;
    }

    .blog-content a:hover {
        text-decoration: underline;
    }

    /* =========================================================
       LISTS
    ========================================================= */

    .blog-content ul,
    .blog-content ol {
        margin: 20px 0 28px;
        padding-left: 28px;

        box-sizing: border-box;
    }

    .blog-content li {
        margin-bottom: 10px;
    }

    /* =========================================================
       BLOCKQUOTE
    ========================================================= */

    .blog-content blockquote {
        margin: 35px 0;
        padding: 22px 28px;

        border-left: 4px solid #2563eb;
        border-radius: 0 12px 12px 0;

        background: #f5f8ff;
        color: #374151;

        font-size: 18px;
        font-style: italic;

        box-sizing: border-box;
    }

    /* =========================================================
       CONTENT IMAGES
    ========================================================= */

    .blog-content img {
        display: block;

        width: 100%;
        max-width: 100%;
        height: auto;

        margin: 35px auto;

        border-radius: 14px;

        box-sizing: border-box;
    }

    /* =========================================================
       TABLE
       
       Prevent tables from breaking mobile layout.
    ========================================================= */

    .blog-content table {
        display: block;

        width: 100%;
        max-width: 100%;

        margin: 30px 0;

        overflow-x: auto;

        border-collapse: collapse;

        box-sizing: border-box;
    }

    .blog-content th,
    .blog-content td {
        padding: 13px 15px;

        border: 1px solid #e5e7eb;

        text-align: left;

        white-space: nowrap;
    }

    .blog-content th {
        background: #f3f4f6;
        font-weight: 700;
    }

    /* =========================================================
       CODE
    ========================================================= */

    .blog-content pre {
        width: 100%;
        max-width: 100%;

        overflow-x: auto;

        margin: 30px 0;
        padding: 20px;

        border-radius: 12px;

        background: #111827;
        color: #f9fafb;

        font-size: 14px;
        line-height: 1.6;

        box-sizing: border-box;

        white-space: pre;
    }

    .blog-content code {
        font-family:
            Consolas,
            Monaco,
            monospace;
    }

    .blog-content :not(pre) > code {
        padding: 3px 7px;

        border-radius: 5px;

        background: #f1f5f9;
        color: #dc2626;

        font-size: 0.9em;

        overflow-wrap: anywhere;
    }

    /* =========================================================
       HR
    ========================================================= */

    .blog-content hr {
        margin: 45px 0;

        border: 0;
        border-top: 1px solid #e5e7eb;
    }

    /* =========================================================
       STRONG
    ========================================================= */

    .blog-content strong {
        color: #111827;
        font-weight: 700;
    }

    /* =========================================================
       LARGE TABLET
       769px - 1100px
    ========================================================= */

    @media (max-width: 1100px) {

        .blog-page {
            padding-left: 15px;
            padding-right: 15px;
        }

        .blog-header {
            padding-left: 30px;
            padding-right: 30px;
        }

        .blog-featured-image {
            width: calc(100% - 40px);

            /*
             * Keep the visual ratio of your
             * 950 x 560 image.
             */
            height: auto;
            aspect-ratio: 950 / 560;

            object-fit: cover;
        }
    }

    /* =========================================================
       TABLET
       481px - 768px
    ========================================================= */

    @media (max-width: 768px) {

        .blog-page {
            padding: 30px 12px 55px;
        }

        .blog-article {
            border-radius: 18px;
        }

        .blog-header {
            padding: 40px 20px 28px;
        }

        .blog-title {
            font-size: clamp(28px, 6vw, 38px);
            letter-spacing: -1px;
        }

        .blog-meta {
            font-size: 14px;
        }

        /*
         * Your image keeps the same
         * 950 x 560 proportion.
         */
        .blog-featured-image {
            width: calc(100% - 30px);
            height: auto;

            aspect-ratio: 950 / 560;

            object-fit: cover;

            border-radius: 12px;
        }

        .blog-description {
            margin-top: 28px;
            padding: 0 20px;

            font-size: 17px;
            line-height: 1.7;
        }

        .blog-content {
            margin-top: 35px;
            padding: 0 20px 50px;

            font-size: 16px;
            line-height: 1.8;
        }

        .blog-content h2 {
            margin-top: 40px;
            font-size: 26px;
        }

        .blog-content h3 {
            font-size: 21px;
        }

        .blog-content blockquote {
            padding: 20px;
        }
    }

    /* =========================================================
       MOBILE
       Up to 480px
    ========================================================= */

    @media (max-width: 480px) {

        .blog-page {
            padding: 15px 8px 40px;
        }

        .blog-container {
            width: 100%;
        }

        .blog-article {
            width: 100%;
            border-radius: 14px;
        }

        .blog-header {
            padding: 30px 15px 22px;
        }

        .blog-category {
            margin-bottom: 15px;
            padding: 6px 12px;

            font-size: 11px;
        }

        .blog-title {
            font-size: 28px;
            line-height: 1.2;
            letter-spacing: -0.5px;
        }

        .blog-meta {
            gap: 7px;
            margin-top: 18px;

            font-size: 13px;
        }

        /*
         * MOBILE IMAGE
         *
         * Width automatically fits screen.
         * Aspect ratio remains 950:560.
         *
         * Example:
         * 350px wide -> approximately 206px high
         */
        .blog-featured-image {
            width: calc(100% - 20px);
            height: auto;

            aspect-ratio: 950 / 560;

            object-fit: cover;

            border-radius: 10px;
        }

        .blog-description {
            margin-top: 25px;
            padding: 0 15px;

            font-size: 16px;
            line-height: 1.7;
        }

        .blog-content {
            margin-top: 30px;
            padding: 0 15px 35px;

            font-size: 15.5px;
            line-height: 1.8;
        }

        .blog-content h2 {
            margin-top: 35px;
            font-size: 23px;
            line-height: 1.3;
        }

        .blog-content h3 {
            margin-top: 30px;
            font-size: 20px;
        }

        .blog-content h4 {
            font-size: 18px;
        }

        .blog-content ul,
        .blog-content ol {
            padding-left: 22px;
        }

        .blog-content blockquote {
            margin: 25px 0;
            padding: 18px;

            font-size: 16px;
        }

        .blog-content pre {
            margin-left: 0;
            margin-right: 0;

            padding: 15px;

            font-size: 13px;
            border-radius: 8px;
        }

        .blog-content table {
            font-size: 14px;
        }

        .blog-content th,
        .blog-content td {
            padding: 10px 12px;
        }
    }

    /* =========================================================
       VERY SMALL MOBILE
       Up to 360px
    ========================================================= */

    @media (max-width: 360px) {

        .blog-page {
            padding-left: 5px;
            padding-right: 5px;
        }

        .blog-header {
            padding-left: 12px;
            padding-right: 12px;
        }

        .blog-title {
            font-size: 25px;
        }

        .blog-featured-image {
            width: calc(100% - 12px);
        }

        .blog-description {
            padding-left: 12px;
            padding-right: 12px;
        }

        .blog-content {
            padding-left: 12px;
            padding-right: 12px;
        }
    }
</style>




</body>

</html>

