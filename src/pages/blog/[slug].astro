---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getBlog } from "../../lib/blogs.js";


export const prerender = false;


const { slug } = Astro.params;


const blog = slug ? await getBlog(slug) : null;


if (!blog) {

  throw Astro.redirect("/blog");

}



const siteUrl = "https://skystates.us";



const canonicalUrl =
  blog.canonical ||
  `${siteUrl}/blog/${blog.slug}`;



const seoTitle =
  blog.seo_title ||
  blog.title;



const seoDescription =
  blog.seo_description ||
  blog.short_description;



const publishDate =
  new Date(blog.created_at).toISOString();



const modifiedDate =
  new Date(blog.updated_at || blog.created_at).toISOString();



const imageUrl =
  blog.image
    ? `${siteUrl}${blog.image}`
    : `${siteUrl}/default-blog-image.jpg`;

---


<!doctype html>

<html lang="en">


<head>


<meta charset="UTF-8" />


<meta 
name="viewport" 
content="width=device-width, initial-scale=1.0" 
/>



<title>{seoTitle}</title>



<meta
name="description"
content={seoDescription}
/>

 <meta
    name="keywords"
    content={blog.keywords || ""}
  />


<link
rel="canonical"
href={canonicalUrl}
/>



<!-- Open Graph SEO -->


<meta
property="og:type"
content="article"
/>


<meta
property="og:title"
content={seoTitle}
/>


<meta
property="og:description"
content={seoDescription}
/>


<meta
property="og:url"
content={canonicalUrl}
/>


<meta
property="og:image"
content={imageUrl}
/>


<meta
property="article:published_time"
content={publishDate}
/>


<meta
property="article:modified_time"
content={modifiedDate}
/>




<!-- Twitter Card -->


<meta
name="twitter:card"
content="summary_large_image"
/>


<meta
name="twitter:title"
content={seoTitle}
/>


<meta
name="twitter:description"
content={seoDescription}
/>


<meta
name="twitter:image"
content={imageUrl}
/>





<!-- Article Schema -->


<script type="application/ld+json">

{

JSON.stringify({

"@context":"https://schema.org",

"@type":"Article",


"headline":blog.title,


"description":seoDescription,


"image":[

imageUrl

],



"author":{

"@type":"Person",

"name":blog.author || "Sky States"

},



"publisher":{

"@type":"Organization",

"name":"Sky States",

"url":siteUrl

},



"datePublished":publishDate,


"dateModified":modifiedDate,



"mainEntityOfPage":{

"@type":"WebPage",

"@id":canonicalUrl

}



})

}

</script>





<!-- Breadcrumb Schema -->


<script type="application/ld+json">

{

JSON.stringify({

"@context":"https://schema.org",

"@type":"BreadcrumbList",


"itemListElement":[


{

"@type":"ListItem",

"position":1,

"name":"Home",

"item":siteUrl

},



{

"@type":"ListItem",

"position":2,

"name":"Blog",

"item":`${siteUrl}/blog`

},



{

"@type":"ListItem",

"position":3,

"name":blog.title,

"item":canonicalUrl

}


]


})

}

</script>




<link

rel="stylesheet"

href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"

/>


</head>



<body>


<Header />



<main class="single-blog-page">


<section class="single-blog">


<div class="blog-wrapper">



<header class="blog-header">



<div class="blog-category">

{blog.category}

</div>




<h1>

{blog.title}

</h1>




<div class="blog-meta">


<span>

By {blog.author || "Sky States"}

</span>



<span>

{

new Date(blog.created_at).toLocaleDateString(

"en-US",

{

day:"numeric",

month:"short",

year:"numeric"

}

)

}

</span>



</div>



</header>





<!-- Optimized Featured Image -->


{

blog.image && (

<figure class="blog-feature-image">


<img

src={blog.image}

alt={blog.title}

title={blog.title}

width="1200"

height="675"

loading="eager"

fetchpriority="high"

/>


</figure>

)

}





<article

class="blog-content"

itemscope

itemtype="https://schema.org/Article"

>



<p class="short-description">

{blog.short_description}

</p>




<div

class="content"

set:html={blog.content}

/>



</article>




</div>


</section>


</main>



<Footer />

<style>

/* =========================
   Main Blog Layout
========================= */


.single-blog-page {

    width:100%;

    background:#ffffff;

    padding-top:90px;

}



.single-blog {

    width:100%;

    padding:60px 25px 100px;

}



.blog-wrapper {

    max-width:1180px;

    margin:auto;

}



/* =========================
   Blog Header
========================= */


.blog-header {

    max-width:950px;

    margin:0 auto 55px;

    text-align:center;

}



.blog-category {

    display:inline-flex;

    align-items:center;

    background:#0071ad;

    color:white;

    padding:8px 20px;

    border-radius:50px;

    font-size:13px;

    font-weight:700;

    letter-spacing:.5px;

    text-transform:uppercase;

    margin-bottom:25px;

}



.blog-header h1 {

    font-size:52px;

    line-height:1.15;

    font-weight:800;

    letter-spacing:-1.2px;

    color:#0f172a;

    margin:0 auto;

}



.blog-meta {

    display:flex;

    justify-content:center;

    gap:15px;

    margin-top:25px;

    color:#64748b;

    font-size:15px;

}





/* =========================
   Featured Image SEO Optimized
========================= */


.blog-feature-image {


    width:100%;


    max-width:1100px;


    margin:0 auto 60px;


    overflow:hidden;


    border-radius:28px;


}


.blog-feature-image img {

    width:100%;

    height:680px;

    object-fit:cover;

    display:block;

    border-radius:28px;

}





/* =========================
   Article Content
========================= */


.blog-content {

    max-width:900px;

    margin:auto;

}



.short-description {


    font-size:22px;


    line-height:1.8;


    color:#334155;


    font-weight:500;


    padding-bottom:35px;


    border-bottom:1px solid #e2e8f0;


    margin-bottom:45px;


}





/* TinyMCE Content */


.content {


    font-size:18px;


    line-height:1.9;


    color:#334155;


}



.content p {

    margin-bottom:28px;

}



.content h2 {


    margin-top:55px;


    margin-bottom:22px;


    font-size:34px;


    line-height:1.3;


    font-weight:750;


    color:#0f172a;


}



.content h3 {


    margin-top:40px;


    margin-bottom:18px;


    font-size:26px;


    font-weight:700;


    color:#0f172a;


}



.content h4 {


    font-size:22px;


    margin-top:30px;


    color:#0f172a;


}





/* Lists */


.content ul,

.content ol {


    margin:25px 0;


    padding-left:35px;


}



.content li {


    margin-bottom:12px;


}





/* Links */


.content a {


    color:#0071ad;


    font-weight:600;


    text-decoration:none;


}



.content a:hover {


    text-decoration:underline;


}





/* Images inside blog content */


.content img {


    width:100%;


    height:auto;


    max-width:100%;


    border-radius:18px;


    margin:35px 0;


}





/* Blockquote */


.content blockquote {


    margin:35px 0;


    padding:25px 30px;


    background:#f0f9ff;


    border-left:5px solid #0071ad;


    border-radius:10px;


    font-size:20px;


    font-style:italic;


    color:#334155;


}





/* Code Blocks */


.content pre {


    background:#0f172a;


    color:#ffffff;


    padding:25px;


    border-radius:15px;


    overflow-x:auto;


    margin:30px 0;


}



.content code {


    font-family:"Fira Code", monospace;


}





/* Tables */


.content table {


    width:100%;


    border-collapse:collapse;


    margin:35px 0;


}



.content th {


    background:#f1f5f9;


    font-weight:700;


}



.content th,

.content td {


    border:1px solid #e2e8f0;


    padding:14px;


    text-align:left;


}





.content strong {


    color:#0f172a;


    font-weight:700;


}





.content hr {


    border:none;


    border-top:1px solid #e2e8f0;


    margin:45px 0;


}





/* =========================
   Responsive Design
========================= */


@media(max-width:900px){


.blog-header h1 {


    font-size:38px;


}



.blog-feature-image img {


    aspect-ratio:16 / 9;


}



.content {


    font-size:17px;


}



}





@media(max-width:600px){


.single-blog {


    padding:40px 15px 70px;


}



.blog-header h1 {


    font-size:30px;


}



.blog-feature-image {


    border-radius:18px;


    margin-bottom:40px;


}



.blog-feature-image img {


    width:100%;


    height:auto;


    aspect-ratio:16 / 9;


    border-radius:18px;


}



.short-description {


    font-size:18px;


}



.content {


    font-size:16px;


}



.content h2 {


    font-size:27px;


}



.content h3 {


    font-size:22px;


}



}



</style>

</body>