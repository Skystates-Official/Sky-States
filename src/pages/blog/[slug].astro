
---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getBlog } from "../../lib/blogs.js";

export const prerender = false;

const { slug } = Astro.params;

const blog = slug ? await getBlog(slug) : null;

if (!blog) {
  return Astro.redirect("/blog");
}

/* ==================================================
   BASIC SITE INFORMATION
================================================== */

const siteUrl = "https://skystates.us";

/* ==================================================
   CANONICAL URL
================================================== */

const canonicalUrl =
  blog.canonical ||
  `${siteUrl}/blog/${blog.slug}`;

/* ==================================================
   SEO TITLE
================================================== */

const seoTitle =
  blog.seo_title?.trim() ||
  blog.title;

/* ==================================================
   SEO DESCRIPTION
================================================== */

const seoDescription =
  blog.seo_description?.trim() ||
  blog.short_description?.trim() ||
  blog.title;

/* ==================================================
   KEYWORDS
================================================== */

const seoKeywords =
  blog.keywords?.trim() || "";

/* ==================================================
   PUBLISH DATE
================================================== */

const publishDate = blog.created_at
  ? new Date(blog.created_at).toISOString()
  : new Date().toISOString();

/* ==================================================
   MODIFIED DATE
================================================== */

const modifiedDate = blog.updated_at
  ? new Date(blog.updated_at).toISOString()
  : publishDate;

/* ==================================================
   DISPLAY DATE
================================================== */

const displayDate = new Date(
  publishDate
).toLocaleDateString(
  "en-US",
  {
    day: "numeric",
    month: "short",
    year: "numeric",
  }
);

/* ==================================================
   READING TIME
================================================== */

const wordCount = blog.content
  ? blog.content
      .replace(/<[^>]*>/g, " ")
      .replace(/\s+/g, " ")
      .trim()
      .split(" ")
      .filter(Boolean)
      .length
  : 0;

const readingTime = Math.max(
  1,
  Math.round(wordCount / 200)
);

/* ==================================================
   BLOG IMAGE
================================================== */

const imageUrl = blog.image
  ? blog.image.startsWith("http")
    ? blog.image
    : blog.image.startsWith("/")
      ? blog.image
      : `/${blog.image}`
  : `${siteUrl}/default-blog-image.jpg`;

/* ==================================================
   AUTHOR
================================================== */

const authorName =
  blog.author?.trim() ||
  "Sky States";

const authorInitial =
  authorName
    .trim()
    .charAt(0)
    .toUpperCase();

/* ==================================================
   CATEGORY
================================================== */

const category =
  blog.category?.trim() ||
  "Technology";

/* ==================================================
   BLOG URL
================================================== */

const blogUrl =
  `${siteUrl}/blog/${blog.slug}`;

/* ==================================================
   DESCRIPTION FOR SOCIAL SHARING
================================================== */

const socialDescription =
  seoDescription.length > 200
    ? `${seoDescription.substring(0, 197)}...`
    : seoDescription;
---

<!doctype html>

<html lang="en">

<head>

  <!-- ==================================================
       BASIC SEO
  ================================================== -->

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>{seoTitle}</title>

  <meta
    name="description"
    content={socialDescription}
  />

  <meta
    name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  />

  <meta
    name="author"
    content={authorName}
  />

  {
    seoKeywords && (
      <meta
        name="keywords"
        content={seoKeywords}
      />
    )
  }


  <!-- ==================================================
       CANONICAL
  ================================================== -->

  <link
    rel="canonical"
    href={canonicalUrl}
  />


  <!-- ==================================================
       OPEN GRAPH
  ================================================== -->

  <meta
    property="og:type"
    content="article"
  />

  <meta
    property="og:site_name"
    content="Sky States"
  />

  <meta
    property="og:title"
    content={seoTitle}
  />

  <meta
    property="og:description"
    content={socialDescription}
  />

  <meta
    property="og:url"
    content={canonicalUrl}
  />

  <meta
    property="og:image"
    content={imageUrl}
  />

  <meta
    property="og:image:width"
    content="1400"
  />

  <meta
    property="og:image:height"
    content="744"
  />

  <meta
    property="og:image:alt"
    content={blog.title}
  />

  <meta
    property="article:published_time"
    content={publishDate}
  />

  <meta
    property="article:modified_time"
    content={modifiedDate}
  />

  <meta
    property="article:author"
    content={authorName}
  />

  <meta
    property="article:section"
    content={category}
  />


  <!-- ==================================================
       TWITTER CARD
  ================================================== -->

  <meta
    name="twitter:card"
    content="summary_large_image"
  />

  <meta
    name="twitter:title"
    content={seoTitle}
  />

  <meta
    name="twitter:description"
    content={socialDescription}
  />

  <meta
    name="twitter:image"
    content={imageUrl}
  />

  <meta
    name="twitter:image:alt"
    content={blog.title}
  />


  <!-- ==================================================
       MATERIAL SYMBOLS
  ================================================== -->

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
  />


  <!-- ==================================================
       ARTICLE STRUCTURED DATA
  ================================================== -->

  <script type="application/ld+json">
    {
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",

        "@id": `${blogUrl}#article`,

        headline: blog.title,

        description: seoDescription,

        image: [
          imageUrl
        ],

        url: canonicalUrl,

        mainEntityOfPage: {
          "@type": "WebPage",
          "@id": canonicalUrl
        },

        datePublished: publishDate,

        dateModified: modifiedDate,

        author: {
          "@type": "Person",
          name: authorName
        },

        publisher: {
          "@type": "Organization",

          name: "Sky States",

          url: siteUrl,

          logo: {
            "@type": "ImageObject",
            url: `${siteUrl}/logo.png`
          }
        },

        articleSection: category,

        keywords: seoKeywords
      })
    }
  </script>


  <!-- ==================================================
       BREADCRUMB STRUCTURED DATA
  ================================================== -->

  <script type="application/ld+json">
    {
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",

        itemListElement: [

          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: siteUrl
          },

          {
            "@type": "ListItem",
            position: 2,
            name: "Blog",
            item: `${siteUrl}/blog`
          },

          {
            "@type": "ListItem",
            position: 3,
            name: blog.title,
            item: canonicalUrl
          }

        ]
      })
    }
  </script>


  <!-- ==================================================
       WEBPAGE STRUCTURED DATA
  ================================================== -->

  <script type="application/ld+json">
    {
      JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebPage",

        "@id": `${canonicalUrl}#webpage`,

        url: canonicalUrl,

        name: seoTitle,

        description: seoDescription,

        isPartOf: {
          "@type": "WebSite",
          name: "Sky States",
          url: siteUrl
        },

        primaryImageOfPage: {
          "@type": "ImageObject",
          url: imageUrl
        },

        datePublished: publishDate,

        dateModified: modifiedDate
      })
    }
  </script>


  <!-- ==================================================
       CUSTOM UI STYLES
  ================================================== -->

  <style>

    /* ==================================================
       PAGE BACKGROUND
    ================================================== */

    .blog-page {

      background:

        radial-gradient(
          circle at 10% 10%,
          rgba(59, 130, 246, 0.10),
          transparent 30%
        ),

        radial-gradient(
          circle at 90% 20%,
          rgba(99, 102, 241, 0.08),
          transparent 28%
        ),

        linear-gradient(
          180deg,
          #f8fafc 0%,
          #f1f5f9 45%,
          #ffffff 100%
        );

    }


    /* ==================================================
       ARTICLE CONTAINER
    ================================================== */

    .blog-shell {

      position: relative;

      overflow: hidden;

      border:
        1px solid
        rgba(226, 232, 240, 0.9);

      background:
        rgba(255, 255, 255, 0.92);

      box-shadow:

        0 20px 60px
        rgba(15, 23, 42, 0.07),

        0 5px 20px
        rgba(15, 23, 42, 0.04);

      backdrop-filter: blur(12px);

    }


    .blog-shell::before {

      content: "";

      position: absolute;

      width: 420px;

      height: 420px;

      border-radius: 999px;

      background:
        rgba(59, 130, 246, 0.06);

      filter: blur(20px);

      top: -250px;

      left: -180px;

      pointer-events: none;

    }


    .blog-shell::after {

      content: "";

      position: absolute;

      width: 380px;

      height: 380px;

      border-radius: 999px;

      background:
        rgba(99, 102, 241, 0.05);

      filter: blur(20px);

      top: -180px;

      right: -180px;

      pointer-events: none;

    }


    /* ==================================================
       HERO
    ================================================== */

    .blog-hero {

      position: relative;

      z-index: 1;

    }


    /* ==================================================
       CATEGORY
    ================================================== */

    .category-badge {

      box-shadow:
        0 8px 25px
        rgba(37, 99, 235, 0.10);

    }


    /* ==================================================
       TITLE
    ================================================== */

    .title-gradient {

      background:

        linear-gradient(
          135deg,
          #0f172a 0%,
          #1e3a8a 55%,
          #2563eb 100%
        );

      -webkit-background-clip: text;

      background-clip: text;

      color: transparent;

    }


    /* ==================================================
       META CARD
    ================================================== */

    .meta-card {

      border:
        1px solid
        #e2e8f0;

      background:
        rgba(248, 250, 252, 0.8);

      box-shadow:
        0 8px 25px
        rgba(15, 23, 42, 0.04);

    }


    /* ==================================================
       FEATURED IMAGE
    ================================================== */

    .featured-image-wrap {

      position: relative;

      overflow: hidden;

      border-radius: 22px;

      background:
        #f1f5f9;

      box-shadow:

        0 25px 55px
        rgba(15, 23, 42, 0.14),

        0 6px 20px
        rgba(15, 23, 42, 0.06);

    }


    .featured-image-wrap::after {

      content: "";

      position: absolute;

      inset: 0;

      background:

        linear-gradient(
          180deg,
          transparent 65%,
          rgba(15, 23, 42, 0.10)
        );

      pointer-events: none;

    }


    .featured-image {

      transition:

        transform
        700ms
        cubic-bezier(.2,.7,.2,1),

        filter
        500ms
        ease;

    }


    .featured-image-wrap:hover
    .featured-image {

      transform:
        scale(1.02);

      filter:
        saturate(1.05);

    }


    /* ==================================================
       DESCRIPTION
    ================================================== */

    .description-box {

      position: relative;

      border:
        1px solid
        #dbeafe;

      background:

        linear-gradient(
          135deg,
          rgba(239, 246, 255, 0.95),
          rgba(248, 250, 252, 0.95)
        );

      box-shadow:

        0 12px 35px
        rgba(37, 99, 235, 0.06);

    }


    .description-box::before {

      content: "";

      position: absolute;

      left: 0;

      top: 20px;

      bottom: 20px;

      width: 4px;

      border-radius: 999px;

      background:

        linear-gradient(
          180deg,
          #2563eb,
          #6366f1
        );

    }


    /* ==================================================
       ARTICLE CONTENT
    ================================================== */

    .article-content :global(h2) {

      position: relative;

      margin-top: 2.5rem;

      margin-bottom: 1rem;

      padding-left: 1rem;

    }


    .article-content :global(h2::before) {

      content: "";

      position: absolute;

      left: 0;

      top: 0.3em;

      width: 4px;

      height: 1.2em;

      border-radius: 999px;

      background:

        linear-gradient(
          180deg,
          #2563eb,
          #6366f1
        );

    }


    .article-content :global(h3) {

      margin-top: 2rem;

      margin-bottom: 0.8rem;

    }


    .article-content :global(p) {

      color:
        #475569;

    }


    .article-content :global(a) {

      transition:
        color 180ms ease;

    }


    .article-content :global(a:hover) {

      color:
        #1d4ed8;

    }


    /* ==================================================
       BLOCKQUOTE
    ================================================== */

    .article-content :global(blockquote) {

      position: relative;

      overflow: hidden;

      border:
        1px solid
        #dbeafe;

      border-left:
        5px solid
        #2563eb;

      background:

        linear-gradient(
          135deg,
          #eff6ff,
          #f8fafc
        );

      box-shadow:

        0 10px 30px
        rgba(37, 99, 235, 0.06);

    }


    /* ==================================================
       CODE BLOCK
    ================================================== */

    .article-content :global(pre) {

      border:
        1px solid
        #1e293b;

      box-shadow:

        0 15px 35px
        rgba(15, 23, 42, 0.12);

    }


    /* ==================================================
       TABLE
    ================================================== */

    .article-content :global(table) {

      width:
        100%;

      border-collapse:
        separate;

      border-spacing:
        0;

      overflow:
        hidden;

    }


    .article-content :global(th) {

      background:
        #f1f5f9;

      color:
        #0f172a;

      font-weight:
        700;

    }


    .article-content :global(th),
    .article-content :global(td) {

      border-color:
        #e2e8f0;

    }


    /* ==================================================
       CONTENT IMAGES
    ================================================== */

    .article-content :global(img) {

      transition:
        transform 400ms ease;

    }


    .article-content :global(img:hover) {

      transform:
        translateY(-2px);

    }


    /* ==================================================
       BACK BUTTON
    ================================================== */

    .back-link {

      transition:
        transform 180ms ease,
        background-color 180ms ease;

    }


    .back-link:hover {

      transform:
        translateX(-3px);

    }


    /* ==================================================
       AUTHOR AVATAR
    ================================================== */

    .author-avatar {

      box-shadow:
        0 5px 15px
        rgba(37, 99, 235, 0.25);

    }


    /* ==================================================
       MOBILE
    ================================================== */

    @media (max-width: 640px) {

      .featured-image-wrap {

        border-radius:
          16px;

      }


      .title-gradient {

        background:

          linear-gradient(
            135deg,
            #0f172a,
            #1d4ed8
          );

        -webkit-background-clip:
          text;

        background-clip:
          text;

      }

    }

  </style>

</head>


<body
  class="bg-white text-slate-900"
>


  <!-- ==================================================
       HEADER
  ================================================== -->

  <Header />


  <!-- ==================================================
       BLOG PAGE
  ================================================== -->

  <main
    class="blog-page w-full min-h-screen px-3 sm:px-5 pt-8 sm:pt-12 lg:pt-16 pb-16 sm:pb-24"
  >

    <div
      class="w-full max-w-[1280px] mx-auto"
    >


      <!-- ==================================================
           BACK TO BLOG
      ================================================== -->

      <div
        class="max-w-[1050px] mx-auto mb-5 sm:mb-7 px-1"
      >

        <a
          href="/blog"
          class="back-link inline-flex items-center gap-2 rounded-full border border-slate-200 bg-white/80 px-4 py-2 text-sm font-semibold text-slate-600 shadow-sm no-underline hover:bg-white hover:text-blue-600"
        >

          <span
            class="material-symbols-outlined text-[18px]"
          >
            arrow_back
          </span>

          Back to Blog

        </a>

      </div>


      <!-- ==================================================
           ARTICLE
      ================================================== -->

      <article
        class="blog-shell w-full rounded-[22px] sm:rounded-[32px]"
        itemscope
        itemtype="https://schema.org/Article"
      >


        <!-- ==================================================
             BLOG HERO
        ================================================== -->

        <header
          class="blog-hero w-full max-w-[1050px] mx-auto px-5 sm:px-8 lg:px-12 pt-10 sm:pt-16 lg:pt-20 pb-7 sm:pb-10 text-center"
        >

          <!-- CATEGORY -->

          {blog.category && (

            <a
              href={`/blog?category=${encodeURIComponent(blog.category)}`}
              class="category-badge inline-flex items-center gap-2 mb-5 sm:mb-7 px-4 py-2 rounded-full border border-blue-100 bg-blue-50 text-blue-700 text-[11px] sm:text-xs font-extrabold tracking-[0.14em] uppercase no-underline transition hover:bg-blue-100 hover:-translate-y-0.5"
              itemprop="articleSection"
            >

              <span
                class="material-symbols-outlined text-[17px]"
              >
                auto_awesome
              </span>

              {blog.category}

            </a>

          )}


          <!-- TITLE -->

          <h1
            class="title-gradient m-0 font-black leading-[1.08] text-[30px] sm:text-[42px] lg:text-[58px] tracking-[-1px] sm:tracking-[-1.5px] lg:tracking-[-2px] break-words [overflow-wrap:anywhere]"
            itemprop="headline"
          >

            {blog.title}

          </h1>


          <!-- DESCRIPTION -->

          {blog.short_description && (

            <p
              class="max-w-[820px] mx-auto mt-5 sm:mt-7 mb-0 text-[15px] sm:text-[18px] lg:text-[20px] leading-[1.7] text-slate-500"
              itemprop="description"
            >

              {blog.short_description}

            </p>

          )}


          <!-- ==================================================
               META CARD
          ================================================== -->

          <div
            class="meta-card inline-flex items-center justify-center flex-wrap gap-2 sm:gap-3 mt-7 sm:mt-9 p-2 rounded-2xl"
          >


            <!-- AUTHOR -->

            <span
              class="inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2"
            >

              <span
                class="author-avatar inline-flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-white text-xs font-extrabold"
                aria-hidden="true"
              >
                {authorInitial}
              </span>

              <span class="text-left">

                <span
                  class="block text-[10px] uppercase tracking-wider font-bold text-slate-400"
                >
                  Written by
                </span>

                <span
                  class="block text-xs sm:text-sm font-bold text-slate-700"
                >
                  {authorName}
                </span>

              </span>

            </span>


            <span
              class="hidden sm:block w-px h-7 bg-slate-200"
              aria-hidden="true"
            ></span>


            <!-- DATE -->

            <span
              class="inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2"
            >

              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-blue-50 text-blue-600"
              >

                <span
                  class="material-symbols-outlined text-[18px]"
                >
                  calendar_today
                </span>

              </span>

              <span class="text-left">

                <span
                  class="block text-[10px] uppercase tracking-wider font-bold text-slate-400"
                >
                  Published
                </span>

                <time
                  class="block text-xs sm:text-sm font-bold text-slate-700"
                  datetime={publishDate}
                  itemprop="datePublished"
                >
                  {displayDate}
                </time>

              </span>

            </span>


            <span
              class="hidden sm:block w-px h-7 bg-slate-200"
              aria-hidden="true"
            ></span>


            <!-- READING TIME -->

            <span
              class="inline-flex items-center gap-2 rounded-xl bg-white px-3 py-2"
            >

              <span
                class="inline-flex items-center justify-center w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600"
              >

                <span
                  class="material-symbols-outlined text-[18px]"
                >
                  schedule
                </span>

              </span>

              <span class="text-left">

                <span
                  class="block text-[10px] uppercase tracking-wider font-bold text-slate-400"
                >
                  Reading time
                </span>

                <span
                  class="block text-xs sm:text-sm font-bold text-slate-700 whitespace-nowrap"
                >
                  {readingTime} min read
                </span>

              </span>

            </span>

          </div>

        </header>


        <!-- ==================================================
             FEATURED IMAGE
             1000PX MAX WIDTH
        ================================================== -->

        {blog.image && (

          <div
            class="w-full max-w-[1000px] mx-auto px-4 sm:px-6"
          >

            <div
              class="featured-image-wrap"
            >

              <img
                class="featured-image block w-full aspect-[16/8.5] object-cover bg-slate-100"
                src={imageUrl}
                alt={blog.title}
                title={blog.title}
                width="1400"
                height="744"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                itemprop="image"
              />

            </div>

          </div>

        )}


        <!-- ==================================================
             CONTENT
        ================================================== -->

        <div class="relative">


          <!-- SHORT DESCRIPTION -->

          {blog.short_description && (

            <div
              class="description-box max-w-[850px] mx-[18px] sm:mx-auto mt-7 sm:mt-10 px-6 sm:px-8 py-5 sm:py-6 rounded-2xl text-slate-600 text-[15px] sm:text-[17px] leading-[1.75] break-words [overflow-wrap:anywhere]"
            >

              <div class="pl-3">

                <span
                  class="block mb-1 text-[11px] font-extrabold uppercase tracking-[0.15em] text-blue-600"
                >
                  In this article
                </span>

                {blog.short_description}

              </div>

            </div>

          )}


          <!-- ==================================================
               BLOG CONTENT
          ================================================== -->

          <div
            class="article-content prose prose-sm sm:prose-lg max-w-[850px] mx-auto mt-8 sm:mt-12 px-[18px] sm:px-[30px] pb-12 sm:pb-[80px] break-words [overflow-wrap:anywhere]

            prose-headings:text-slate-900
            prose-headings:font-extrabold
            prose-headings:tracking-[-0.3px]

            prose-h2:text-[25px]
            sm:prose-h2:text-[32px]

            prose-h3:text-[21px]
            sm:prose-h3:text-[25px]

            prose-p:text-slate-600
            prose-p:leading-[1.85]

            prose-a:text-blue-600
            prose-a:font-semibold
            prose-a:no-underline

            hover:prose-a:underline

            prose-strong:text-slate-900

            prose-li:text-slate-600
            prose-li:leading-[1.75]
            prose-li:marker:text-blue-600

            prose-blockquote:not-italic
            prose-blockquote:font-normal
            prose-blockquote:rounded-r-2xl
            prose-blockquote:py-5
            prose-blockquote:px-6

            prose-img:rounded-2xl
            prose-img:shadow-xl

            prose-figcaption:text-center
            prose-figcaption:text-slate-500

            prose-table:block
            prose-table:overflow-x-auto
            prose-table:rounded-xl
            prose-table:border
            prose-table:border-slate-200

            prose-thead:bg-slate-50

            prose-code:text-blue-700
            prose-code:bg-blue-50
            prose-code:rounded
            prose-code:px-1.5
            prose-code:py-0.5
            prose-code:font-medium
            prose-code:before:content-none
            prose-code:after:content-none

            prose-pre:bg-slate-950
            prose-pre:rounded-2xl
            prose-pre:text-[13px]
            prose-pre:shadow-xl

            prose-hr:border-slate-200"
            itemprop="articleBody"
            set:html={blog.content}
          ></div>

        </div>


        <!-- ==================================================
             ARTICLE FOOTER
        ================================================== -->

        <div
          class="border-t border-slate-200 bg-slate-50/70 px-5 sm:px-8 py-7 sm:py-9"
        >

          <div
            class="max-w-[850px] mx-auto flex flex-col sm:flex-row items-center justify-between gap-5"
          >

            <!-- AUTHOR -->

            <div
              class="flex items-center gap-3"
            >

              <span
                class="inline-flex items-center justify-center w-11 h-11 rounded-full bg-gradient-to-br from-blue-600 to-indigo-600 text-white font-extrabold shadow-lg"
              >
                {authorInitial}
              </span>

              <div>

                <p
                  class="m-0 text-xs font-bold uppercase tracking-wider text-slate-400"
                >
                  Written by
                </p>

                <p
                  class="m-0 mt-0.5 text-sm font-bold text-slate-800"
                >
                  {authorName}
                </p>

              </div>

            </div>


            <!-- MORE ARTICLES -->

            <a
              href="/blog"
              class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 px-5 py-3 text-sm font-bold text-white shadow-lg shadow-blue-600/20 no-underline transition hover:-translate-y-0.5 hover:shadow-xl"
            >

              Explore More Articles

              <span
                class="material-symbols-outlined text-[18px]"
              >
                arrow_forward
              </span>

            </a>

          </div>

        </div>

      </article>

    </div>

  </main>


  <!-- ==================================================
       FOOTER
  ================================================== -->

  <Footer />

</body>

</html>

