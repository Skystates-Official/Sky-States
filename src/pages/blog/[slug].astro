---
import Layout from "../../layouts/Layout.astro";
import { query } from "../../db/sqlite.js";

const { slug } = Astro.params;

// Fetch blog by slug
const blog = await query.get(`
  SELECT *
  FROM blogs 
  WHERE slug = ? AND status = 'published'
`, [slug]);

// Handle 404
if (!blog) {
  return Astro.redirect('/404');
}

// Parse SEO metadata safely
let seoMeta: any = {};
if (blog.seo_metadata) {
  try { seoMeta = JSON.parse(blog.seo_metadata); } catch(e){}
}

const pageTitle = blog.seo_title || `${blog.title} | Sky States Blog`;
const pageDesc = blog.seo_description || blog.short_description || "Read this article on Sky States.";

// Format date
const publishDate = blog.published_at 
  ? new Date(blog.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
  : 'Recently Published';

// Split tags
const tagsList = blog.tags ? blog.tags.split(',').map((t: string) => t.trim()).filter((t: string) => t.length > 0) : [];
---

<Layout title={pageTitle} description={pageDesc}>
  <main class="pt-24 pb-20 bg-surface">
    <article class="max-w-3xl mx-auto px-6">
      
      <!-- Back Link & Breadcrumbs -->
      <nav class="mb-8 flex items-center gap-2 text-sm font-label-md text-on-surface-variant">
        <a href="/blog" class="hover:text-primary transition-colors flex items-center gap-1">
          <span class="material-symbols-outlined text-[18px]">arrow_back</span>
          All Articles
        </a>
        <span>/</span>
        <span class="truncate">{blog.category || 'Uncategorized'}</span>
      </nav>

      <!-- Header Information -->
      <header class="mb-10 text-center">
        {blog.category && (
          <span class="inline-block bg-primary-container text-on-primary-container text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-4">
            {blog.category}
          </span>
        )}
        <h1 class="text-4xl md:text-5xl font-headline-lg font-bold text-on-surface mb-6 leading-tight">
          {blog.title}
        </h1>
        
        <div class="flex items-center justify-center gap-4 text-on-surface-variant font-label-sm">
          <div class="flex items-center gap-2">
             <div class="w-8 h-8 rounded-full bg-surface-container-highest flex items-center justify-center text-on-surface font-bold text-xs uppercase">
               {blog.author ? blog.author.charAt(0) : 'A'}
             </div>
             <span class="font-bold">{blog.author || 'Sky States Team'}</span>
          </div>
          <span>&bull;</span>
          <span>{publishDate}</span>
        </div>
      </header>

      <!-- Featured Image -->
      {blog.image && (
        <div class="mb-12 rounded-2xl overflow-hidden shadow-md border border-outline-variant relative h-[400px]">
          <img src={blog.image} alt={blog.title} class="w-full h-full object-cover" />
        </div>
      )}

      <!-- Blog Content (Rendered HTML) -->
      <div class="prose prose-lg max-w-none text-on-surface marker:text-primary prose-a:text-primary prose-a:no-underline hover:prose-a:underline prose-headings:text-on-surface prose-strong:text-on-surface" set:html={blog.content}>
      </div>

      <!-- Footer Tags -->
      {tagsList.length > 0 && (
        <footer class="mt-12 pt-8 border-t border-outline-variant flex flex-wrap gap-2">
          {tagsList.map((tag: string) => (
            <span class="px-3 py-1 bg-surface-container rounded-full text-xs font-label-sm text-on-surface-variant border border-outline-variant">
              #{tag}
            </span>
          ))}
        </footer>
      )}

    </article>
  </main>
</Layout>

<style is:global>
  /* Extra styling for Quill output if needed to match Tailwind Prose */
  .prose img {
    border-radius: 0.75rem;
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .prose pre {
    background-color: var(--color-surface-container-highest);
    color: var(--color-on-surface);
    border: 1px solid var(--color-outline-variant);
  }
</style>
