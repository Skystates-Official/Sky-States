---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import { query } from "../../db/sqlite.js";

// Fetch published blogs from DB
const blogs = await query.all(`
  SELECT id, title, slug, category, short_description, image, author, published_at
  FROM blogs 
  WHERE status = 'published' 
  ORDER BY published_at DESC
`);
---

<Layout title="Blog | Sky States" description="Guides, Tutorials & Software Insights.">
  <main class="pt-20">
    <!-- Header Section -->
    <section class="py-20 bg-surface">
      <div class="max-w-6xl mx-auto text-center px-6">
        <h1 class="font-headline-lg text-5xl font-bold mb-6 text-on-surface">
          Guides, Tutorials & Software Insights
        </h1>
        <p class="text-on-surface-variant font-body-lg text-lg max-w-3xl mx-auto">
          Learn Data Science, AI, DevOps, Cloud Computing, Cyber Security, and accelerate your career.
        </p>
      </div>
    </section>

    <!-- Filter / Search (Visual only for now, can be implemented with JS later) -->
    <section class="pb-12 bg-surface">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-2 gap-6">
          <select class="border border-outline bg-surface text-on-surface rounded-xl p-4 w-full focus:ring-2 focus:ring-primary">
            <option>Browse by Category</option>
            <option>Data Science</option>
            <option>Cloud</option>
            <option>DevOps</option>
            <option>Cyber Security</option>
          </select>
          <input type="text" placeholder="Search Articles..." class="border border-outline bg-surface text-on-surface rounded-xl p-4 w-full focus:ring-2 focus:ring-primary" />
        </div>
      </div>
    </section>

    <!-- Blog Grid -->
    <section class="pb-24 bg-surface">
      <div class="max-w-7xl mx-auto px-6">
        {blogs.length === 0 ? (
          <div class="text-center py-20 text-on-surface-variant font-label-lg">
            No published blogs found. Check back later!
          </div>
        ) : (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {blogs.map((blog) => (
              <article class="bg-surface-container-lowest rounded-2xl border border-outline-variant shadow-sm overflow-hidden hover:shadow-md transition group flex flex-col h-full">
                <a href={`/blog/${blog.slug}`} class="block overflow-hidden relative">
                  {blog.image ? (
                    <img src={blog.image} alt={blog.title} class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300" />
                  ) : (
                    <div class="w-full h-56 bg-surface-container-highest flex items-center justify-center text-on-surface-variant group-hover:scale-105 transition-transform duration-300">
                      No Image
                    </div>
                  )}
                  {blog.category && (
                    <div class="absolute top-4 left-4 bg-primary text-on-primary text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                      {blog.category}
                    </div>
                  )}
                </a>
                <div class="p-6 flex flex-col flex-1">
                  <p class="text-sm text-on-surface-variant mb-2">
                    {blog.published_at ? new Date(blog.published_at).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) : 'Recently Published'}
                  </p>
                  <h2 class="text-xl font-bold mb-3 text-on-surface group-hover:text-primary transition-colors line-clamp-2">
                    <a href={`/blog/${blog.slug}`}>{blog.title}</a>
                  </h2>
                  <p class="text-on-surface-variant mb-6 line-clamp-3 flex-1">
                    {blog.short_description || 'Click to read this article.'}
                  </p>
                  
                  <div class="flex items-center justify-between mt-auto pt-4 border-t border-outline-variant">
                    <div class="flex items-center gap-2">
                       <div class="w-8 h-8 rounded-full bg-surface-container flex items-center justify-center text-primary font-bold text-xs uppercase">
                         {blog.author ? blog.author.charAt(0) : 'A'}
                       </div>
                       <span class="font-label-sm text-sm text-on-surface">{blog.author || 'Admin'}</span>
                    </div>
                    <a href={`/blog/${blog.slug}`} class="text-primary font-bold text-sm hover:underline flex items-center gap-1">
                      Read More <span class="material-symbols-outlined text-[16px]">arrow_forward</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>
