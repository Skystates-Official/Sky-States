---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Geist:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terms & Conditions - Sky States</title>
    <meta
      name="description"
      content="Read the Sky States Terms & Conditions. Learn about our educational programs, services, communication policies, and website use terms."
    />
    <link rel="canonical" href="https://skystates.us/terms-and-conditions" />
    <style>
      body { overflow-x: hidden; }
      /* Push content below fixed navbar */
      main { padding-top: 4rem; }
      @media (min-width: 768px) { main { padding-top: 4.5rem; } }
      @media (min-width: 1024px) { main { padding-top: 5rem; } }
    </style>
  </head>
  <body class="bg-slate-50/50 text-slate-800 font-sans min-h-screen overflow-x-hidden">
    <Header />
    <main class="min-h-screen pb-24 px-4 sm:px-6 flex justify-center">
      <article
        class="w-full max-w-4xl bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-200/60 p-8 sm:p-12 md:p-16 space-y-10"
      >
        <!-- Hero/Header Section -->
        <div class="text-center space-y-4 border-b border-slate-100 pb-8">
          <span
            class="inline-block bg-sky-50 border border-sky-100 text-sky-700 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider"
          >
            Legal
          </span>
          <h1 class="text-3xl sm:text-4xl font-bold text-[#0f3473] tracking-tight">
            Terms & Conditions
          </h1>
          <p class="text-slate-500 text-sm font-semibold max-w-2xl mx-auto">
            Effective Date: August 19, 2026
          </p>
        </div>

        <!-- Policy Content -->
        <div class="space-y-8 text-slate-700 leading-relaxed text-base">
          
          <div class="space-y-4">
            <p class="text-slate-600 leading-relaxed">
              Welcome to Sky States LLC ("Sky States," "we," "us," or "our"). These Terms & Conditions ("Terms") govern your access to and use of the Sky States website, located at <a href="https://skystates.us/" class="text-sky-600 font-semibold hover:underline">https://skystates.us/</a>, and your participation in our educational, training, career-support, consultation, enrollment, and related services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              By accessing our website, submitting an inquiry or enrollment form, enrolling in a program, or using our services, you agree to these Terms. If you do not agree with these Terms, please do not use our website or services.
            </p>
          </div>

          <!-- Section 1 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">1. About Sky States</h2>
            <p class="text-slate-600 leading-relaxed">
              Sky States LLC provides technology education and career-development services, including training and educational programs in areas such as:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Data Science and Artificial Intelligence</li>
              <li>Cybersecurity and Ethical Hacking</li>
              <li>DevOps and Cloud Computing</li>
              <li>Software and technology-related training</li>
              <li>Practical projects and hands-on learning</li>
              <li>Career guidance and interview preparation</li>
              <li>Resume and LinkedIn profile assistance</li>
              <li>Career and placement support</li>
              <li>Educational consultations and related services</li>
            </ul>
            <p class="text-slate-600 leading-relaxed">
              Program features, schedules, pricing, curriculum, availability, and other service details may vary by program and may be updated from time to time.
            </p>
          </div>

          <!-- Section 2 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">2. Website Use</h2>
            <p class="text-slate-600 leading-relaxed">
              You agree to use this website only for lawful purposes and in accordance with these Terms. You may not:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Use the website for unlawful, fraudulent, or unauthorized purposes.</li>
              <li>Attempt to interfere with the operation or security of the website.</li>
              <li>Access or attempt to access systems or information that you are not authorized to access.</li>
              <li>Submit false, misleading, or inaccurate information.</li>
              <li>Copy, reproduce, distribute, or exploit website content without authorization.</li>
            </ul>
            <p class="text-slate-600 leading-relaxed">
              We reserve the right to suspend or restrict access to the website or services where reasonably necessary to protect our users, systems, business, or legal rights.
            </p>
          </div>

          <!-- Section 3 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">3. Educational Programs and Services</h2>
            <p class="text-slate-600 leading-relaxed">
              Sky States provides educational and career-development services intended to help learners develop practical technology skills and improve their career readiness. Participation in a Sky States program does not guarantee employment, a particular salary, a promotion, a job offers, or any particular career outcome.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Career support may include resume assistance, interview preparation, LinkedIn profile guidance, career coaching, portfolio guidance, networking assistance, and other career-related services. The availability and scope of these services may vary by program.
            </p>
          </div>

          <!-- Section 4 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">4. Program Information and Pricing</h2>
            <p class="text-slate-600 leading-relaxed">
              Program descriptions, tuition, deposits, schedules, curriculum, included resources, and other enrollment information are provided on the website or during the enrollment process.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Current pricing and enrollment terms applicable to a particular program will be presented to the customer before enrollment or payment. Sky States reserves the right to change program offerings, pricing, schedules, curriculum, instructors, or other program details when reasonably necessary.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Any refund, cancellation, or return rights applicable to your purchase are governed by the applicable Refund & Returns Policy and the terms presented to you at the time of purchase.
            </p>
          </div>

          <!-- Section 5 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">5. User Information</h2>
            <p class="text-slate-600 leading-relaxed">
              When you submit a form or otherwise communicate with Sky States, you agree to provide information that is accurate and current.
            </p>
            <p class="text-slate-600 leading-relaxed">
              The information you provide may be used to respond to inquiries, provide requested services, process enrollment, communicate regarding programs, provide career support, schedule consultations, provide customer support, and otherwise administer our services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              For information about how personal information is collected, used, protected, and disclosed, please review our Privacy Policy: <br>
              <strong>Privacy Policy:</strong> <a href="https://skystates.us/privacy-policy" class="text-sky-600 font-semibold hover:underline">https://skystates.us/privacy-policy</a>
            </p>
          </div>

          <!-- Section 6 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">6. Intellectual Property</h2>
            <p class="text-slate-600 leading-relaxed">
              Unless otherwise stated, the content available through the Sky States website, including text, graphics, logos, branding, photographs, videos, course materials, designs, and other materials, is owned by or licensed to Sky States LLC and may be protected by applicable intellectual-property laws.
            </p>
            <p class="text-slate-600 leading-relaxed">
              You may not reproduce, distribute, modify, publicly display, sell, license, or otherwise exploit protected Sky States content without prior written permission, except where permitted by law or expressly authorized by Sky States.
            </p>
          </div>

          <!-- Section 7 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">7. Third-Party Services and Links</h2>
            <p class="text-slate-600 leading-relaxed">
              Our website or services may contain links to third-party websites, platforms, payment processors, learning-management systems, or other services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Third-party services are governed by their own terms and privacy policies. Sky States is not responsible for the content, security, availability, or practices of third-party websites or services that are outside our control.
            </p>
          </div>

          <!-- Section 8 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">8. Communications</h2>
            <p class="text-slate-600 leading-relaxed">
              By providing your contact information, you may receive communications from Sky States concerning your inquiries, consultations, enrollment, programs, scheduling, customer support, career services, or other services you have requested.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Where required, we will obtain appropriate consent before sending marketing or SMS communications. Your consent to receive SMS messages is not a condition of purchasing goods or services.
            </p>
          </div>

          <!-- SMS Terms of Service Heading -->
          <div class="pt-8 pb-4">
              <h2 class="text-2xl font-bold text-[#0f3473]">SMS Terms of Service</h2>
          </div>

          <!-- Section 9 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">9. SMS Program</h2>
            <p class="text-slate-600 leading-relaxed">
              By opting in to receive SMS messages from Sky States LLC through an online form or other supported method, you agree to receive SMS messages at the mobile telephone number you provide.
            </p>
            <p class="text-slate-600 leading-relaxed">
              SMS messages may include, depending on the services you request or the program for which you have opted in:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Consultation and appointment reminders</li>
              <li>Course and program inquiries</li>
              <li>Enrollment and registration communications</li>
              <li>Class or schedule notifications</li>
              <li>Account or service notifications</li>
              <li>Customer-support communications</li>
              <li>Career-support communications</li>
              <li>Important updates concerning requested services</li>
              <li>Promotional or informational messages, where you have provided the applicable consent</li>
            </ul>
            <p class="text-slate-600 leading-relaxed">
              Message frequency may vary depending on your interactions with Sky States and the services or communications for which you have opted in.
            </p>
          </div>

          <!-- Section 10 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">10. SMS Opt-In Method</h2>
            <p class="text-slate-600 leading-relaxed">
              You may opt in to receive SMS messages from Sky States LLC by voluntarily submitting an online form that includes an SMS consent checkbox or other clearly identified SMS consent mechanism. The SMS consent disclosure will be presented near the applicable phone-number field and consent option.
            </p>
            <p class="text-slate-600 leading-relaxed font-semibold text-slate-800">
              SMS consent is not required as a condition of purchasing any goods or services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              If you do not wish to receive SMS messages, you may leave the SMS consent option unchecked.
            </p>
          </div>

          <!-- Section 11 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">11. SMS Opt-Out Method</h2>
            <p class="text-slate-600 leading-relaxed">
              You may opt out of receiving SMS messages at any time by replying STOP to an SMS message from Sky States. After receiving your STOP request, we will process the request and stop sending SMS messages to that number, except where permitted or required by applicable law.
            </p>
            <p class="text-slate-600 leading-relaxed">
              You may also contact us directly to request removal from SMS communications:<br>
              <strong>Phone:</strong> (888) 810-2434<br>
              <strong>Email:</strong> <a href="mailto:support@skystates.us" class="text-sky-600 font-semibold hover:underline">support@skystates.us</a>
            </p>
            <p class="text-slate-600 leading-relaxed">
              Please note that opting out of SMS messages does not necessarily opt you out of other forms of communication, such as email or communications necessary to provide services you have requested.
            </p>
          </div>

          <!-- Section 12 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">12. SMS Help</h2>
            <p class="text-slate-600 leading-relaxed">
              For assistance with SMS communications, reply HELP to any Sky States SMS message. You may also contact us directly:
            </p>
            <p class="text-slate-600 leading-relaxed">
              <strong>Website:</strong> <a href="https://skystates.us" class="text-sky-600 font-semibold hover:underline">https://skystates.us</a><br>
              <strong>Phone:</strong> (888) 810-2434<br>
              <strong>Email:</strong> <a href="mailto:support@skystates.us" class="text-sky-600 font-semibold hover:underline">support@skystates.us</a>
            </p>
          </div>

          <!-- Section 13 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">13. Message and Data Rates</h2>
            <p class="text-slate-600 leading-relaxed">
              Message and data rates may apply. Your mobile carrier's standard messaging and data rates may apply to SMS messages sent or received through the Sky States SMS program. Sky States does not control the rates charged by your mobile carrier.
            </p>
          </div>

          <!-- Section 14 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">14. Supported Carriers</h2>
            <p class="text-slate-600 leading-relaxed">
              SMS availability may depend on your mobile carrier and geographic location. Sky States is not responsible for delays or failures in SMS delivery caused by your mobile carrier or other third-party telecommunications providers.
            </p>
          </div>

          <!-- Section 15 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">15. Privacy and SMS Consent</h2>
            <p class="text-slate-600 leading-relaxed">
              Your privacy is important to us. For information regarding the personal information we collect, how we use it, and the circumstances under which information may be disclosed, please review our Privacy Policy: <a href="https://skystates.us/privacy-policy" class="text-sky-600 font-semibold hover:underline">https://skystates.us/privacy-policy</a>
            </p>
            <p class="text-slate-600 leading-relaxed font-semibold text-slate-800">
              SMS opt-in consent and phone numbers collected for SMS purposes will NOT be shared with third parties or affiliates for their own marketing purposes under any circumstances.
            </p>
            <p class="text-slate-600 leading-relaxed">
              SMS consent is not shared with third parties or affiliates for marketing purposes.
            </p>
          </div>

          <!-- Section 16 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">16. Changes to These Terms</h2>
            <p class="text-slate-600 leading-relaxed">
              Sky States LLC may update these Terms & Conditions from time to time. Updated Terms will be posted on this page with a revised effective date. Your continued use of the website or services after changes are posted constitutes acceptance of the updated Terms, to the extent permitted by applicable law.
            </p>
          </div>

          <!-- Section 17 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">17. Disclaimer</h2>
            <p class="text-slate-600 leading-relaxed">
              The website and its content are provided for informational and educational purposes. While Sky States makes reasonable efforts to provide accurate and useful information, we do not guarantee that all website content will always be complete, current, or error-free.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Educational and career-support services are intended to assist learners in developing skills and career readiness. No employment, salary, placement, promotion, or other specific career outcome is guaranteed.
            </p>
          </div>

          <!-- Section 18 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">18. Limitation of Liability</h2>
            <p class="text-slate-600 leading-relaxed">
              To the extent permitted by applicable law, Sky States LLC will not be liable for indirect, incidental, consequential, special, or punitive damages arising from or related to your use of the website or services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              Nothing in these Terms is intended to exclude or limit liability that cannot legally be excluded or limited under applicable law.
            </p>
          </div>

          <!-- Section 19 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900">19. Contact Information</h2>
            <p class="text-slate-600 leading-relaxed">
              If you have questions regarding these Terms & Conditions, SMS communications, or our services, please contact us:
            </p>
            <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 text-slate-700 space-y-2 mt-4">
              <p><strong>Sky States LLC</strong></p>
              <p>1316 Wall St, Suite 2C</p>
              <p>Everett, WA 98201, USA</p>
              <p><strong>Phone:</strong> <a href="tel:8888102434" class="text-sky-600 hover:underline">(888) 810-2434</a></p>
              <p><strong>Email:</strong> <a href="mailto:info@skystates.us" class="text-sky-600 hover:underline">info@skystates.us</a></p>
              <p><strong>Support:</strong> <a href="mailto:support@skystates.us" class="text-sky-600 hover:underline">support@skystates.us</a></p>
              <p><strong>Website:</strong> <a href="https://skystates.us" class="text-sky-600 hover:underline">https://skystates.us</a></p>
              <p><strong>Privacy Policy:</strong> <a href="https://skystates.us/privacy-policy" class="text-sky-600 hover:underline">https://skystates.us/privacy-policy</a></p>
            </div>
          </div>

        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
