---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import { getBlog } from "../../lib/blogs.js";

export const prerender = false;

const { slug } = Astro.params;

const blog = slug ? await getBlog(slug) : null;

if (!blog) {
    return Astro.redirect("/blog");
}

/* ==================================================
   SEO
================================================== */

const siteUrl = "https://skystates.us";

const canonicalUrl =
    blog.canonical || `${siteUrl}/blog/${blog.slug}`;

const seoTitle =
    blog.seo_title || blog.title;

const seoDescription =
    blog.seo_description ||
    blog.short_description ||
    "";

const publishDate = blog.created_at
    ? new Date(blog.created_at).toISOString()
    : new Date().toISOString();

const modifiedDate = blog.updated_at
    ? new Date(blog.updated_at).toISOString()
    : publishDate;

/* ==================================================
   DISPLAY DATE
   Always derived from the SAME safe value used for
   SEO (publishDate), so there is no path where this
   throws or renders "Invalid Date".
================================================== */

const displayDate = new Date(publishDate).toLocaleDateString(
    "en-US",
    {
        day: "numeric",
        month: "short",
        year: "numeric"
    }
);

/* ==================================================
   READING TIME
================================================== */

const wordCount = blog.content
    ? blog.content.replace(/<[^>]*>/g, " ").trim().split(/\s+/).filter(Boolean).length
    : 0;

const readingTime = Math.max(1, Math.round(wordCount / 200));


/* ==================================================
   IMAGE URL
================================================== */

const imageUrl = blog.image
    ? blog.image.startsWith("http")
        ? blog.image
        : blog.image.startsWith("/")
            ? blog.image
            : `/${blog.image}`
    : "/default-blog-image.jpg";


const authorName =
    blog.author || "Sky States";

const authorInitial = authorName.trim().charAt(0).toUpperCase();
---

<!doctype html>

<html lang="en">

<head>

    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <title>{seoTitle}</title>

    <meta
        name="description"
        content={seoDescription}
    />

    <meta
        name="keywords"
        content={blog.keywords || ""}
    />

    <link
        rel="canonical"
        href={canonicalUrl}
    />


    <!-- ==================================================
         OPEN GRAPH
    ================================================== -->

    <meta property="og:type" content="article" />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="article:published_time" content={publishDate} />
    <meta property="article:modified_time" content={modifiedDate} />
    <meta property="article:section" content={blog.category || ""} />
    <meta property="article:author" content={authorName} />


    <!-- ==================================================
         TWITTER
    ================================================== -->

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={imageUrl} />


    <!-- ==================================================
         MATERIAL SYMBOLS
    ================================================== -->

    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />


    <!-- ==================================================
         ARTICLE SCHEMA
    ================================================== -->

    <script type="application/ld+json">
        {JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Article",
            headline: blog.title,
            description: seoDescription,
            image: [imageUrl],
            author: { "@type": "Person", name: authorName },
            publisher: {
                "@type": "Organization",
                name: "Sky States",
                url: siteUrl,
                logo: { "@type": "ImageObject", url: `${siteUrl}/logo.png` }
            },
            datePublished: publishDate,
            dateModified: modifiedDate,
            mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
            articleSection: blog.category || "",
            keywords: blog.keywords || ""
        })}
    </script>

</head>


<body>

    <Header />


    <!-- ==================================================
         BLOG PAGE
    ================================================== -->

    <main class="w-full min-h-screen px-3 sm:px-5 pt-7 sm:pt-14 pb-16 sm:pb-24 box-border bg-gradient-to-b from-slate-50 to-slate-100">

        <div class="w-full max-w-[1180px] mx-auto box-border">

            <article
                class="w-full overflow-hidden box-border bg-white border border-gray-200 rounded-[14px] sm:rounded-3xl shadow-[0_10px_30px_rgba(15,23,42,0.06),0_30px_70px_rgba(15,23,42,0.05)]"
                itemscope
                itemtype="https://schema.org/Article"
            >

                <!-- ==================================================
                     BLOG HEADER
                ================================================== -->

                <header class="w-full max-w-[850px] mx-auto px-[18px] sm:px-[30px] pt-8 sm:pt-14 pb-6 sm:pb-9 box-border text-center">

                    {blog.category && (

                        <a
                            href={`/blog?category=${encodeURIComponent(blog.category)}`}
                            class="inline-flex items-center justify-center mb-3.5 sm:mb-5 px-3 sm:px-4 py-1.5 border border-blue-100 rounded-full bg-blue-50 text-blue-600 text-[11px] sm:text-xs font-bold tracking-wider uppercase no-underline transition hover:bg-blue-100 hover:-translate-y-px"
                            itemprop="articleSection"
                        >
                            {blog.category}
                        </a>

                    )}


                    <h1
                        class="m-0 text-gray-900 font-extrabold leading-[1.2] sm:leading-[1.15] text-[26px] sm:text-[38px] lg:text-[50px] tracking-[-0.4px] sm:tracking-[-1px] lg:tracking-[-1.4px] break-words [overflow-wrap:anywhere]"
                        itemprop="headline"
                    >
                        {blog.title}
                    </h1>


                    <!-- ==================================================
                         BLOG META
                    ================================================== -->

                    <div class="flex items-center justify-center flex-wrap gap-x-2 gap-y-1.5 sm:gap-y-2.5 mt-4 sm:mt-6 text-gray-500 text-[12.5px] sm:text-[15px]">

                        <span class="inline-flex items-center gap-2">

                            <span
                                class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-blue-600 text-white text-[11px] font-bold shrink-0"
                                aria-hidden="true"
                            >
                                {authorInitial}
                            </span>

                            <span>
                                By <strong class="text-gray-700 font-semibold">{authorName}</strong>
                            </span>

                        </span>


                        <span class="text-gray-300" aria-hidden="true">•</span>


                        <time datetime={publishDate} itemprop="datePublished">
                            {displayDate}
                        </time>


                        <span class="text-gray-300" aria-hidden="true">•</span>


                        <span class="whitespace-nowrap">
                            {readingTime} min read
                        </span>

                    </div>

                </header>


                <!-- ==================================================
                     FEATURED IMAGE

                     aspect-video (16:9) reserves the space before the
                     image loads, so there's no layout shift, and it
                     never distorts at any breakpoint.
                ================================================== -->

                {blog.image && (

                    <div class="w-full max-w-[910px] mx-auto px-[18px] sm:px-[30px] box-border">

                        <img
                            class="block w-full h-auto aspect-video object-cover rounded-[10px] sm:rounded-2xl bg-slate-100 shadow-[0_12px_30px_rgba(15,23,42,0.08)]"
                            src={imageUrl}
                            alt={blog.title}
                            title={blog.title}
                            width="1200"
                            height="675"
                            loading="eager"
                            fetchpriority="high"
                            itemprop="image"
                        />

                    </div>

                )}


                <!-- ==================================================
                     SHORT DESCRIPTION
                ================================================== -->

                {blog.short_description && (

                    <div
                        class="w-full max-w-[850px] mx-auto mt-[22px] sm:mt-9 px-[18px] sm:px-[30px] box-border text-gray-600 text-[15.5px] sm:text-[19px] leading-[1.7] sm:leading-[1.75] text-center break-words [overflow-wrap:anywhere]"
                        itemprop="description"
                    >
                        {blog.short_description}
                    </div>

                )}


                <!-- ==================================================
                     BLOG CONTENT

                     Styled entirely via @tailwindcss/typography since
                     this HTML comes from the CMS and can't carry
                     utility classes directly. Requires the plugin to
                     be registered in tailwind.config.
                ================================================== -->

                <div
                    class="prose prose-sm sm:prose-lg max-w-[850px] mx-auto mt-7 sm:mt-11 px-[18px] sm:px-[30px] pb-9 sm:pb-[70px] box-border break-words [overflow-wrap:anywhere]
                        prose-headings:text-gray-900 prose-headings:font-bold
                        prose-a:text-blue-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:underline
                        prose-blockquote:not-italic prose-blockquote:font-normal prose-blockquote:border-l-4 prose-blockquote:border-blue-600 prose-blockquote:bg-blue-50 prose-blockquote:rounded-r-xl prose-blockquote:py-4 prose-blockquote:px-6
                        prose-strong:text-gray-900
                        prose-li:marker:text-blue-600
                        prose-img:rounded-2xl prose-img:shadow-lg
                        prose-figcaption:text-center
                        prose-table:block prose-table:overflow-x-auto prose-table:rounded-lg prose-table:border prose-table:border-gray-200
                        prose-thead:bg-slate-50
                        prose-code:text-red-600 prose-code:bg-slate-100 prose-code:rounded prose-code:px-1.5 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none
                        prose-pre:bg-gray-900 prose-pre:rounded-xl prose-pre:text-[13.5px]
                        prose-hr:border-gray-200"
                    itemprop="articleBody"
                    set:html={blog.content}
                ></div>


            </article>

        </div>

    </main>


    <Footer />

</body>

</html>