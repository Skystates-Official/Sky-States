                <ul class="space-y-2 text-xs text-slate-600 font-medium pt-1">
                  <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-600 text-sm">check_circle</span>
                    <span><strong>Program Format:</strong> Live Instructor-Led Training</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-600 text-sm">check_circle</span>
                    <span><strong>Program Duration:</strong> 4–6 Months</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-600 text-sm">check_circle</span>
                    <span><strong>Projects:</strong> 10+ Industry-Oriented Projects</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-600 text-sm">check_circle</span>
                    <span><strong>Capstone:</strong> End-to-End AI Project</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-sky-600 text-sm">check_circle</span>
                    <span><strong>Learning:</strong> Practical, Project-Based Training</span>
                  </li>
                </ul>
                <div class="flex items-baseline gap-2 pt-2">
                  <span class="text-3xl font-black text-sky-700">$6,999</span>
                  <span class="text-xs text-slate-400 font-semibold"
                    >/ Regular Price / Live Training</span
                  >
                </div>
                <a
                  href="/checkout?course=Agentic+AI+%26+Automation&type=1on1"
