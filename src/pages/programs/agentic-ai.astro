---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ToolLogoMarquee from "../../components/ToolLogoMarquee.astro";
import { programToolLogos } from "../../data/program-tools.js";
import programsData from "../../data/programs.json";

const program = {
  hero: {
    headline: "Sky States Agentic AI & Generative AI Professional Program <br/><span style=\"color:#12A5D8\" class=\"text-4xl block mt-2\">Master AI Engineering with Agentic AI, Generative AI, RAG & LLMs</span>",
    description: "Master Generative AI, Large Language Models, AI Agents, RAG, Multi-Agent Systems, LangChain, LangGraph, Python, FastAPI, Cloud Deployment, and AI Automation through live instructor-led training, hands-on industry-oriented projects, mentorship, and career preparation. Build real-world AI applications, develop an industry-ready portfolio, and prepare for high-demand AI engineering and LLM-focused career opportunities."
  },
  curriculum: {
    title: "Program Curriculum",
    description: "A practical, project-focused program covering the technologies used to build modern AI applications and intelligent workflows.",
    modules: [
      { id: "01", title: "Generative AI & LLM Foundations", description: "Understand generative AI, large language models, their capabilities, and their role in modern AI applications.", tags: ["Generative AI", "LLMs", "AI Foundations", "Transformers"] },
      { id: "02", title: "Prompt Engineering & AI Reasoning", description: "Learn prompt engineering techniques and AI reasoning concepts for developing effective AI-powered solutions.", tags: ["Prompt Engineering", "AI Reasoning", "Chain-of-Thought", "Prompt Design"] },
      { id: "03", title: "AI Agents, ReAct & Autonomous Workflows", description: "Learn how AI agents operate, reason through tasks, use tools, and execute autonomous multi-step workflows.", tags: ["AI Agents", "ReAct Framework", "Autonomous Workflows", "Tool Usage"] },
      { id: "04", title: "RAG, Vector Databases & AI Memory", description: "Build retrieval-augmented generation applications and understand vector databases and AI memory.", tags: ["RAG", "Vector Databases", "Embeddings", "AI Memory"] },
      { id: "05", title: "LangChain & LangGraph", description: "Develop AI workflows and applications using LangChain and LangGraph.", tags: ["LangChain", "LangGraph", "Workflow Graphs", "Agent State"] },
      { id: "06", title: "CrewAI & AutoGen Multi-Agent Systems", description: "Learn how to design and implement multi-agent systems using CrewAI and AutoGen.", tags: ["CrewAI", "AutoGen", "Multi-Agent Systems", "Agent Collaboration"] },
      { id: "07", title: "API & Tool Calling", description: "Connect AI models with APIs and external tools to create more capable and automated AI applications.", tags: ["API Integration", "Function Calling", "Tool Calling", "Automation"] },
      { id: "08", title: "AI Code Generation & Intelligent Automation", description: "Use AI-powered code generation and intelligent automation techniques to improve development workflows and business processes.", tags: ["Code Generation", "Intelligent Automation", "Developer Tools", "Workflow Optimization"] },
      { id: "09", title: "Python for AI Application Development", description: "Strengthen Python development skills required for building modern AI-powered applications.", tags: ["Python", "AsyncIO", "OOP", "AI Libraries"] },
      { id: "10", title: "FastAPI & AI Application Development", description: "Build application interfaces and AI-powered services using Python and FastAPI.", tags: ["FastAPI", "REST APIs", "Backend Services", "Python"] },
      { id: "11", title: "Docker & Cloud Deployment", description: "Learn how to package and deploy AI applications using Docker across AWS, Azure, and GCP environments.", tags: ["Docker", "AWS", "Azure", "GCP", "Cloud Deployment"] },
      { id: "12", title: "AI Safety, Guardrails & Model Evaluation", description: "Understand AI safety practices, guardrails, and methods for evaluating AI models and applications.", tags: ["AI Safety", "Guardrails", "Model Evaluation", "Alignment"] },
      { id: "13", title: "Capstone Project", description: "Apply the complete learning journey to an end-to-end AI project that can be showcased through your portfolio and GitHub.", tags: ["Capstone Project", "End-to-End AI", "Portfolio", "GitHub"] }
    ]
  },
  career: {
    stats: [
      { label: "Duration", value: "4-6 Months" },
      { label: "Projects", value: "10+" },
      { label: "Format", value: "Live" }
    ]
  }
};
const { hero } = program;
export const prerender = false;
---

<!doctype html>
<html class="scroll-smooth" lang="en">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Agentic AI & Generative AI Professional Program | Sky States LLC</title>
    <meta name="description" content="Master modern AI application development by learning how to build intelligent systems with RAG, AI memory, agentic AI, generative AI, and LLM technologies through practical, hands-on training." />
    <meta name="keywords" content="Agentic AI, Generative AI, LLM Engineering, RAG, Multi-Agent Systems, LangChain, LangGraph, Python, FastAPI, Cloud Deployment, AI Automation" />
    <link
      rel="canonical"
      href="https://skystates.us/programs/agentic-ai"
    />
    <meta
      property="og:title"
      content="Agentic AI & Generative AI Professional Program | Sky States"
    />
    <meta
      property="og:description"
      content="Learn how to build context-aware and knowledge-driven AI applications using RAG, AI memory, agentic AI, generative AI, and modern LLM technologies."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Geist:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Course",
        "name": "Agentic AI & Generative AI Professional Program",
        "description": "Master modern AI application development by learning how to build intelligent systems with RAG, AI memory, agentic AI, generative AI, and LLM technologies.",
        "provider": {
          "@type": "Organization",
          "name": "Sky States",
          "url": "https://skystates.us"
        },
        "url": "https://skystates.us/programs/agentic-ai",
        "educationalLevel": "Intermediate to Advanced",
        "courseMode": "Online",
        "inLanguage": "en",
        "teaches": [
          "Generative AI",
          "LLM Engineering",
          "RAG",
          "AI Agents",
          "LangChain",
          "LangGraph",
          "CrewAI",
          "AutoGen",
          "FastAPI",
          "Docker"
        ]
      }
    </script>

    <style>
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .sky-gradient-up {
        background: linear-gradient(to top, #ffffff, #d3e2ed);
      }
      .ambient-shadow {
        box-shadow: 0 10px 30px -5px rgba(15, 29, 37, 0.04);
      }
      .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
      }
    </style>

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How long is the Agentic AI & Generative AI Professional Program?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The program is designed as a 4–6 month professional program, with live instructor-led training and structured practical learning."
            }
          },
          {
            "@type": "Question",
            "name": "Who is this program designed for?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The program is designed for software engineers, data scientists, ML engineers, DevOps engineers, cloud professionals, and experienced IT professionals looking to transition into or advance toward AI-focused roles."
            }
          },
          {
            "@type": "Question",
            "name": "How many projects are included?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The program includes 10+ hands-on industry-oriented projects along with an end-to-end capstone project."
            }
          }
        ]
      }
    </script>
  </head>
  <body class="bg-white text-slate-800 font-sans overflow-x-hidden">
    <!-- TopAppBar -->
    <Header />
    <main class="mt-20">
      <!-- Section 1: Hero -->
      <section
        class="relative px-4 md:px-margin-desktop overflow-hidden py-12 md:py-16 bg-white"
      >
        <div
          class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
        >
          <!-- Left content column -->
          <div class="z-10 lg:col-span-7 flex flex-col gap-6">
            <!-- Premium Pill Badge -->
            <div
              class="inline-flex items-center gap-2.5 px-4 py-1.5 bg-sky-50 border border-sky-100 text-sky-700 rounded-full w-fit text-xs font-semibold shadow-sm backdrop-blur-sm"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"
                ></span>
              </span>
              <span
                class="tracking-wider uppercase font-bold text-[10px] sm:text-xs"
                >Career Acceleration Program</span
              >
            </div>

            <h1
              class="text-4xl font-bold text-slate-900 tracking-tight"
              set:html={hero.headline}
            />
            <p class="text-lg max-w-xl leading-relaxed">
              {hero.description}
            </p>

            <ul
              class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 text-sm font-medium"
            >
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>4–6 Month Professional Program</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>Live Instructor-Led Training</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>10+ Industry-Oriented Projects</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>End-to-End Capstone Project</span>
              </li>
              <li class="flex items-center gap-3 sm:col-span-2">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>Career & Interview Preparation</span>
              </li>
            </ul>

            <div class="flex flex-col sm:flex-row gap-4 mt-4">
              <a
                href="#pricing"
                class="group flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-to-r from-sky-600 to-blue-700 text-white text-sm font-semibold hover:from-sky-500 hover:to-blue-600 hover:scale-[1.02] shadow-lg shadow-sky-600/15 hover:shadow-sky-600/25 active:scale-[0.98] transition-all duration-200 text-center"
              >
                <span>Enroll in Program</span>
                <span
                  class="material-symbols-outlined text-lg ml-2 font-bold transition-transform duration-200 group-hover:translate-x-1"
                  >arrow_forward</span
                >
              </a>
              <a
                href="#curriculum"
                class="group flex items-center justify-center px-8 py-4 rounded-xl text-sky-700 bg-sky-50/50 border border-sky-200/80 hover:bg-sky-50 hover:border-sky-300 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 font-semibold text-center"
              >
                <span>View Curriculum</span>
              </a>
