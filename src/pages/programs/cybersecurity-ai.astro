---
import "../../styles/global.css";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ToolLogoMarquee from "../../components/ToolLogoMarquee.astro";
import { programToolLogos } from "../../data/program-tools.js";

const program = {
  hero: {
    headline: "Sky States CyberSecurity with AI Program <br/><span style=\"color:#12A5D8\" class=\"text-2xl sm:text-3xl block mt-2 font-bold\">Master AI-Driven Cybersecurity, Threat Detection & LLM Security</span>",
    description: "Master AI-driven threat detection, SOC automation, security AI agents, RAG for security intelligence, LLM and AI application security, adversarial AI, Python, cloud security, and AI governance through live instructor-led training, hands-on industry-oriented projects, mentorship, and career readiness preparation. Gain practical experience creating AI-powered security solutions while building an industry-ready portfolio and preparing for emerging career opportunities in cybersecurity and AI security."
  },
  curriculum: {
    title: "Program Curriculum",
    description: "A comprehensive, hands-on curriculum covering modern cybersecurity defense, AI agent automation, threat detection, and LLM security.",
    modules: [
      { id: "01", title: "Cybersecurity & AI Foundations", description: "Understand core cybersecurity principles, the threat landscape, and how AI and machine learning are reshaping both attack and defense.", tags: ["Cybersecurity Fundamentals", "Threat Landscape", "MITRE ATT&CK", "AI for Security"] },
      { id: "02", title: "Python & Data Skills for Security Automation", description: "Strengthen the Python skills needed to parse logs, call APIs, and build security automation and AI-powered tools.", tags: ["Python", "Log Parsing", "APIs", "AsyncIO"] },
      { id: "03", title: "Machine Learning for Threat Detection", description: "Apply machine learning to security data to detect anomalies, malware indicators, and suspicious behavior.", tags: ["Anomaly Detection", "Classification", "Feature Engineering", "UEBA"] },
      { id: "04", title: "Generative AI & LLM Foundations for Security", description: "Understand generative AI, large language models, and their capabilities and limitations in security contexts.", tags: ["Generative AI", "LLMs", "Transformers", "Security Use Cases"] },
      { id: "05", title: "Prompt Engineering for Security Analysts", description: "Learn prompt design and reasoning techniques for log analysis, threat summarization, and investigation support.", tags: ["Prompt Engineering", "Chain-of-Thought", "Structured Output", "Analyst Workflows"] },
      { id: "06", title: "RAG, Vector Databases & Threat Intelligence Assistants", description: "Build retrieval-augmented applications that search and reason over threat intelligence, advisories, and internal security documentation.", tags: ["RAG", "Vector Databases", "Embeddings", "Threat Intel"] },
      { id: "07", title: "Security AI Agents & Tool Calling", description: "Design AI agents that use security tools and APIs to enrich indicators, query data sources, and run multi-step investigations.", tags: ["AI Agents", "ReAct", "Tool Calling", "Investigation Workflows"] },
      { id: "08", title: "LangChain, LangGraph & Multi-Agent SOC Workflows", description: "Build orchestrated and multi-agent workflows for alert triage, incident investigation, and response, with human-in-the-loop controls.", tags: ["LangChain", "LangGraph", "Multi-Agent Systems", "Human-in-the-Loop"] },
      { id: "09", title: "AI-Driven SOC Operations & Incident Response", description: "Integrate AI into SIEM, SOAR, and incident response processes to reduce analyst workload and improve response consistency.", tags: ["SIEM", "SOAR", "Alert Triage", "Incident Response"] },
      { id: "10", title: "AI-Assisted Offensive Security & Red Teaming", description: "Use AI to support authorized penetration testing, vulnerability analysis, and phishing awareness exercises in controlled lab environments.", tags: ["Pentesting", "Vulnerability Analysis", "Red Teaming", "Phishing Simulation"] },
      { id: "11", title: "Securing LLM & AI Applications", description: "Identify and mitigate risks such as prompt injection, data leakage, insecure plugins and tools, model abuse, and supply chain threats.", tags: ["OWASP LLM Top 10", "Prompt Injection", "Guardrails", "MITRE ATLAS"] },
      { id: "12", title: "Cloud Deployment, AI Governance & Model Evaluation", description: "Deploy AI security applications with Docker across AWS, Azure, and GCP, and apply governance, risk, and evaluation practices to keep them trustworthy.", tags: ["Docker", "AWS", "Azure", "GCP", "NIST AI RMF", "Model Evaluation"] },
      { id: "13", title: "Capstone Project", description: "Apply the complete learning journey to an end-to-end AI security project that can be showcased through your portfolio and GitHub.", tags: ["Capstone Project", "End-to-End AI Security", "Portfolio", "GitHub"] }
    ]
  },
  career: {
    stats: [
      { label: "Duration", value: "4-6 Months" },
      { label: "Projects", value: "10+" },
      { label: "Format", value: "Live" }
    ]
  }
};
const { hero } = program;
export const prerender = false;
---

<!doctype html>
<html class="scroll-smooth" lang="en">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Cybersecurity with AI Professional Program | Sky States LLC</title>
    <meta name="description" content="Master AI-driven cybersecurity, threat detection, security AI agents, RAG for threat intelligence, and LLM security through live instructor-led training and real-world projects." />
    <meta name="keywords" content="Cybersecurity with AI, AI Threat Detection, LLM Security, Security AI Agents, SOC Automation, Adversarial AI, OWASP LLM Top 10, MITRE ATLAS, NIST AI RMF, Python Security" />
    <link
      rel="canonical"
      href="https://skystates.us/programs/cybersecurity-ai"
    />
    <meta
      property="og:title"
      content="Cybersecurity with AI Professional Program | Sky States"
    />
    <meta
      property="og:description"
      content="Master AI-driven cybersecurity, threat detection, security AI agents, and LLM application security with hands-on projects and career readiness preparation."
    />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Geist:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Course",
        "name": "Cybersecurity with AI Professional Program",
        "description": "Master AI-driven threat detection, SOC automation, security AI agents, RAG for threat intelligence, and LLM security.",
        "provider": {
          "@type": "Organization",
          "name": "Sky States",
          "url": "https://skystates.us"
        },
        "url": "https://skystates.us/programs/cybersecurity-ai",
        "educationalLevel": "Intermediate to Advanced",
        "courseMode": "Online",
        "inLanguage": "en",
        "teaches": [
          "AI Threat Detection",
          "Security AI Agents",
          "SOC Automation",
          "LLM Security & OWASP Top 10",
          "Adversarial AI & MITRE ATLAS",
          "RAG for Threat Intelligence",
          "Python Security Automation",
          "Docker & Cloud Deployment"
        ]
      }
    </script>

    <style>
      .material-symbols-outlined {
        font-variation-settings:
          "FILL" 0,
          "wght" 400,
          "GRAD" 0,
          "opsz" 24;
      }
      .sky-gradient-up {
        background: linear-gradient(to top, #ffffff, #d3e2ed);
      }
      .ambient-shadow {
        box-shadow: 0 10px 30px -5px rgba(15, 29, 37, 0.04);
      }
    </style>
  </head>
  <body class="bg-white text-slate-900 font-sans antialiased">
    <!-- Header -->
    <Header />

    <main>
      <!-- Section 1: Hero -->
      <section
        class="relative px-4 md:px-margin-desktop overflow-hidden py-12 md:py-16 bg-white"
      >
        <div
          class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center"
        >
          <!-- Left content column -->
          <div class="z-10 lg:col-span-7 flex flex-col gap-6">
            <!-- Premium Pill Badge -->
            <div
              class="inline-flex items-center gap-2.5 px-4 py-1.5 bg-sky-50 border border-sky-100 text-sky-700 rounded-full w-fit text-xs font-semibold shadow-sm backdrop-blur-sm"
            >
              <span class="relative flex h-2 w-2">
                <span
                  class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"
                ></span>
                <span
                  class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"
                ></span>
              </span>
              <span
                class="tracking-wider uppercase font-bold text-[10px] sm:text-xs"
                >Specialized Program</span
              >
            </div>

            <h1
              class="text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight"
              set:html={hero.headline}
            />
            <p class="text-base sm:text-lg text-slate-600 max-w-xl leading-relaxed">
              {hero.description}
            </p>

            <ul
              class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 text-slate-600 text-sm font-medium"
            >
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>4–6 Month Immersive Track</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>Live Interactive Workshops</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>10+ Production-Grade Projects</span>
              </li>
              <li class="flex items-center gap-3">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>End-to-End Capstone Project</span>
              </li>
              <li class="flex items-center gap-3 sm:col-span-2">
                <span
                  class="material-symbols-outlined text-sky-600 text-lg flex-shrink-0"
                  >check_circle</span
                >
                <span>Corporate Referral &amp; Placement Prep</span>
              </li>
            </ul>

            <div class="flex flex-col sm:flex-row gap-4 mt-2">
              <a
                href="#pricing"
                class="group flex items-center justify-center px-8 py-4 rounded-xl bg-gradient-to-r from-sky-600 to-blue-700 text-white text-sm font-semibold hover:from-sky-500 hover:to-blue-600 hover:scale-[1.02] shadow-lg shadow-sky-600/15 hover:shadow-sky-600/25 active:scale-[0.98] transition-all duration-200 text-center"
              >
                <span>Enroll in Program</span>
                <span
                  class="material-symbols-outlined text-lg ml-2 font-bold transition-transform duration-200 group-hover:translate-x-1"
                  >arrow_forward</span
                >
              </a>
              <a
                href="#curriculum"
                class="group flex items-center justify-center px-8 py-4 rounded-xl text-sky-700 bg-sky-50/50 border border-sky-200/80 hover:bg-sky-50 hover:border-sky-300 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 font-semibold text-center"
              >
                <span>View Curriculum</span>
              </a>
            </div>
          </div>

          <!-- Right Video Mockup Column (col-5) -->
          <div
            class="relative w-full max-w-2xl mx-auto lg:mx-0 lg:col-span-5 mt-12 lg:mt-0"
          >
            <!-- Glowing background ambient light -->
            <div
              class="absolute -inset-4 bg-gradient-to-tr from-sky-400/20 to-blue-500/30 blur-3xl opacity-85 rounded-full pointer-events-none"
            >
            </div>

            <!-- Device frame wrapper -->
            <div
              class="relative p-1.5 bg-gradient-to-b from-slate-100 via-slate-200/60 to-slate-300 rounded-[24px] shadow-2xl border border-slate-200/30 overflow-hidden group"
            >
              <video
                autoplay
                loop
                muted
                playsinline
                class="relative rounded-[18px] w-full aspect-video object-cover transition-transform duration-700 group-hover:scale-[1.005]"
              >
                <source
                  src="/assets/videos/cyber%20security%20hero%20section.mp4"
                  type="video/mp4"
                />
                Your browser does not support the video tag.
              </video>
            </div>

