---
import "../../styles/global.css";

import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

import HowToHero from "../../components/how-to/HowToHero.astro";
import HowToCard from "../../components/how-to/HowToCard.astro";

import { getHowTos } from "../../lib/how_tos.js";

export const prerender = false;

const howTos = await getHowTos();

const postsPerPage = 6;

const currentPage =
    Number(Astro.url.searchParams.get("page")) || 1;

const totalPages =
    Math.ceil(howTos.length / postsPerPage);

const start =
    (currentPage - 1) * postsPerPage;

const currentHowTos =
    howTos.slice(start, start + postsPerPage);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
    />

    <title>How To</title>
</head>

<body>

    <Header />

    <main class="how-to-page mt-20">

        <div class="how-to-container">

            <HowToHero />

            <section class="how-to-grid">

                {
                    currentHowTos.length > 0 ? (
                        currentHowTos.map((howTo) => (
                            <HowToCard how_to={howTo} />
                        ))
                    ) : (
                        <div class="how-to-empty">
                            <h2>No published posts yet</h2>
                            <p>New guides and career insights will appear here soon.</p>
                        </div>
                    )
                }

            </section>

            {
                totalPages > 1 && (

                    <nav class="pagination">

                        {
                            currentPage > 1 && (
                                <a href={`/how-to?page=${currentPage - 1}`}>
                                    ← Previous
                                </a>
                            )
                        }

                        {
                            Array.from(
                                { length: totalPages },
                                (_, index) => index + 1
                            ).map((page) => (

                                <a
                                    href={`/how-to?page=${page}`}
                                    class={page === currentPage ? "active" : ""}
                                >
                                    {page}
                                </a>

                            ))
                        }

                        {
                            currentPage < totalPages && (
                                <a href={`/how-to?page=${currentPage + 1}`}>
                                    Next →
                                </a>
                            )
                        }

                    </nav>

                )
            }

        </div>

    </main>

    <Footer />

</body>
</html>

<style>
.how-to-page{
    width:100%;
}

.how-to-container{
    max-width:1400px;
    width:100%;
    margin:0 auto;
    padding:20px 25px 80px;
}

.how-to-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:30px;
    margin-top:50px;
}

.how-to-empty{
    grid-column:1 / -1;
    text-align:center;
    padding:60px 20px;
    border:1px dashed #cbd5e1;
    border-radius:16px;
    background:#f8fafc;
}

.how-to-empty h2{
    font-size:28px;
    font-weight:750;
    color:#0f172a;
    margin-bottom:10px;
}

.how-to-empty p{
    color:#64748b;
    font-size:16px;
}

.pagination{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:12px;
    margin-top:70px;
    flex-wrap:wrap;
}

.pagination a{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:45px;
    height:42px;
    padding:0 16px;
    border:1px solid #e2e8f0;
    border-radius:8px;
    text-decoration:none;
    color:#0f172a;
    font-weight:600;
    transition:.3s;
}

.pagination a:hover{
    background:#005d90;
    color:white;
    border-color:#005d90;
}

.pagination .active{
    background:#005d90;
    color:white;
    border-color:#005d90;
}

@media(max-width:1024px){
    .how-to-grid{
        grid-template-columns:repeat(2,1fr);
    }
}

@media(max-width:768px){
    .how-to-container{
        padding:20px 15px 60px;
    }

    .how-to-grid{
        grid-template-columns:1fr;
    }
}
</style>