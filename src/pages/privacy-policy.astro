---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Geist:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Privacy Policy - Sky States</title>
    <meta
      name="description"
      content="Read the Sky States privacy policy. Learn how we secure your data, protect student privacy, and enforce strict zero-SSN collection policies."
    />
    <link rel="canonical" href="https://skystates.us/privacy-policy" />
    <style>
      body { overflow-x: hidden; }
      /* Push content below fixed navbar */
      main { padding-top: 4rem; }
      @media (min-width: 768px) { main { padding-top: 4.5rem; } }
      @media (min-width: 1024px) { main { padding-top: 5rem; } }
    </style>
  </head>
  <body class="bg-slate-50/50 text-slate-800 font-sans min-h-screen overflow-x-hidden">
    <Header />
    <main class="min-h-screen pb-24 px-4 sm:px-6 flex justify-center">
      <article
        class="w-full max-w-4xl bg-white rounded-2xl shadow-xl shadow-slate-200/50 border border-slate-200/60 p-8 sm:p-12 md:p-16 space-y-10"
      >
        <!-- Hero/Header Section -->
        <div class="text-center space-y-4 border-b border-slate-100 pb-8">
          <span
            class="inline-block bg-sky-50 border border-sky-100 text-sky-700 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider"
          >
            Data Trust
          </span>
          <h1
            class="text-3xl sm:text-4xl font-bold text-[#0f3473] tracking-tight"
          >
            Privacy Policy
          </h1>
          <p class="text-slate-500 text-base max-w-2xl mx-auto">
            At Sky States LLC, we hold student data security and privacy to institutional standards. Read our comprehensive policies below.
          </p>
        </div>

        <!-- Policy Content -->
        <div class="space-y-10 text-slate-700 leading-relaxed text-base">
          <!-- Section 1 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">lock</span>
              1. Security Commitment & Non-Collection of SSNs
            </h2>
            <p class="text-slate-600 leading-relaxed">
              Sky States is committed to protecting your personal information. We enforce a strict policy regarding sensitive personal identifiers: <strong>Sky States does NOT collect, store, or process Social Security Numbers (SSN)</strong> or equivalent national identification numbers from our students or applicants.
            </p>
          </div>

          <!-- Section 2 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">database</span>
              2. Information We Collect
            </h2>
            <p class="text-slate-600 leading-relaxed">
              We collect minimal personal details necessary to facilitate your training, career services, and billing:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>
                <strong>Contact Information:</strong> Name, professional email address, phone number, and physical address.
              </li>
              <li>
                <strong>Academic & Professional History:</strong> Resume, LinkedIn URL, and academic/STEM background to tailor career placement.
              </li>
              <li>
                <strong>Billing Information:</strong> Payments are securely processed via certified, PCI-compliant third-party gateways (e.g., Stripe). Sky States does not store your credit card credentials on our servers.
              </li>
              <li>
                <strong>SMS & Mobile Information:</strong> If you voluntarily provide your mobile telephone number and opt in to receive SMS communications from Sky States, we may collect your mobile telephone number and information related to your SMS consent and communication preferences. 
                <br><br>
                <span class="font-semibold text-slate-800">SMS opt-in consent or phone numbers collected for SMS purposes will NOT be shared with third parties or affiliates for marketing purposes under any circumstances. SMS consent is not shared with third parties or affiliates for marketing purposes.</span>
              </li>
            </ul>
          </div>

          <!-- Section 3 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">query_stats</span>
              3. How We Use Personal Information
            </h2>
            <p class="text-slate-600 leading-relaxed">
              We may use the personal information we collect to:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Respond to inquiries and requests.</li>
              <li>Provide information about our educational programs, training, career services, consultations, and other services.</li>
              <li>Process applications, registrations, and enrollments.</li>
              <li>Provide educational and career-support services.</li>
              <li>Schedule consultations, classes, meetings, and other requested services.</li>
              <li>Provide customer and student support.</li>
              <li>Process payments and manage billing.</li>
              <li>Send service-related communications, including enrollment, scheduling, account, support, and program-related notifications.</li>
              <li>Send SMS communications when you have provided the required consent.</li>
              <li>Maintain, operate, secure, and improve our website and services.</li>
              <li>Comply with applicable laws and legal obligations.</li>
            </ul>
          </div>

          <!-- Section 4 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">group_add</span>
              4. Who We Share Personal Information With
            </h2>
            <p class="text-slate-600 leading-relaxed">
              Sky States may share personal information with third-party service providers when reasonably necessary to operate our business and provide requested services. These may include:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Payment processors and payment service providers used to process transactions.</li>
              <li>Website hosting, technology, cloud, and infrastructure providers.</li>
              <li>Learning-management and educational technology providers.</li>
              <li>Customer-support and communication service providers.</li>
              <li>Scheduling and other service providers that assist us in providing requested services.</li>
              <li>Professional advisers or service providers assisting us with our business operations.</li>
              <li>Government authorities, courts, regulators, or other parties when required by law or legal process.</li>
            </ul>
            <p class="text-slate-600 leading-relaxed font-semibold text-slate-800 pt-2">
              We do not share SMS opt-in consent or phone numbers collected for SMS purposes with third parties or affiliates for their own marketing purposes. SMS consent is not shared with third parties or affiliates for marketing purposes.
            </p>
          </div>

          <!-- Section 5 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">sms</span>
              5. SMS Communications
            </h2>
            <p class="text-slate-600 leading-relaxed">
              If you voluntarily opt in to receive SMS messages from Sky States, you may receive messages related to services or communications you have requested, which may include:
            </p>
            <ul class="list-disc pl-6 text-slate-600 space-y-2">
              <li>Consultation and appointment reminders</li>
              <li>Course and program inquiries</li>
              <li>Enrollment and registration communications</li>
              <li>Class or schedule notifications</li>
              <li>Account or service notifications</li>
              <li>Customer-support communications</li>
              <li>Career-support communications</li>
              <li>Important updates regarding requested services</li>
              <li>Promotional or informational messages where you have provided the applicable consent</li>
            </ul>
            <p class="text-slate-600 leading-relaxed">
              Message frequency may vary. Message and data rates may apply.
            </p>
            <p class="text-slate-600 leading-relaxed">
              You may opt out of receiving SMS messages at any time by replying "STOP" to any SMS message you receive. For assistance, reply "HELP" or visit <a href="https://skystates.us" class="text-sky-600 font-semibold hover:underline">https://skystates.us</a>.
            </p>
            <p class="text-slate-600 leading-relaxed">
              If you do not wish to receive SMS messages, you may choose not to check the SMS consent box on our forms. SMS consent is not a condition of purchasing any goods or services.
            </p>
            <p class="text-slate-600 leading-relaxed">
              For more information regarding SMS communications, please review our Terms & Conditions:<br>
              <a href="/terms-and-conditions" class="text-sky-600 font-semibold hover:underline">https://skystates.us/terms-and-conditions</a>.
            </p>
          </div>

          <!-- Section 6 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">screen_share</span>
              6. Screen Share & Live Class Interaction
            </h2>
            <p class="text-slate-600 leading-relaxed">
              During our live weekend instruction, interactive labs, and capstone project evaluations, students may be requested to share their screens. This is conducted solely for real-time pedagogical support, code debugging, and skills assessment. Screen sharing sessions are never recorded without explicit, prior student consent.
            </p>
          </div>

          <!-- Section 7 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">shield</span>
              7. Data Protection Standards
            </h2>
            <p class="text-slate-600 leading-relaxed">
              All data transmitted to or from the Sky States platform is encrypted in transit using industry-standard SSL/TLS technology. Access to student records is strictly restricted to authorized educational mentors and career services coordinators.
            </p>
          </div>

          <!-- Section 8 -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">contact_support</span>
              8. Privacy Inquiries
            </h2>
            <p class="text-slate-600 leading-relaxed">
              For any questions, modifications, or deletion requests regarding your personal data records, please reach out directly to our privacy officer at <a href="mailto:info@skystates.us" class="text-sky-600 font-semibold hover:underline">info@skystates.us</a> or <a href="mailto:support@skystates.us" class="text-sky-600 font-semibold hover:underline">support@skystates.us</a>.
            </p>
            <p class="text-slate-600 leading-relaxed">
              For SMS-related questions or assistance, you may also contact Sky States at <a href="tel:8888102434" class="text-sky-600 font-semibold hover:underline">(888) 810-2434</a> or <a href="mailto:support@skystates.us" class="text-sky-600 font-semibold hover:underline">support@skystates.us</a>.
            </p>
          </div>

          <!-- Contact Us -->
          <div class="space-y-3 pt-4 border-t border-slate-100">
            <h2 class="text-xl font-bold text-slate-900 flex items-center gap-3">
              <span class="material-symbols-outlined text-[#1b4a9a]">location_on</span>
              Contact Us
            </h2>
            <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 text-slate-700 space-y-2 mt-4">
              <p><strong>Sky States LLC</strong></p>
              <p>1316 Wall St, Suite 2C</p>
              <p>Everett, WA 98201, USA</p>
              <p><strong>Phone:</strong> <a href="tel:8888102434" class="text-sky-600 hover:underline">(888) 810-2434</a></p>
              <p><strong>Email:</strong> <a href="mailto:info@skystates.us" class="text-sky-600 hover:underline">info@skystates.us</a></p>
              <p><strong>Support:</strong> <a href="mailto:support@skystates.us" class="text-sky-600 hover:underline">support@skystates.us</a></p>
              <p class="text-xs pt-4 border-t border-slate-200 mt-4">&copy; 2026 Sky States LLC Institutional Excellence in Technology. All rights reserved.</p>
            </div>
          </div>

        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
