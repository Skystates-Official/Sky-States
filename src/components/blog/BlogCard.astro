---

const { blog } = Astro.props;

const image =
  blog.image && blog.image.trim() !== ""
    ? blog.image
    : "https://placehold.co/600x400?text=No+Image";
---

<a href={`/blog/${blog.slug}`} class="blog-link">

    <article class="blog-card">

        <div class="image">

            <img
                src={image}
                alt={blog.title}
                loading="lazy"
            />

        </div>

        <div class="content">

            <div class="meta">

                <span class="category">
                    {blog.category}
                </span>

                <small>
                    {new Date(blog.created_at).toLocaleDateString("en-US", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    })}
                </small>

            </div>

            <h3>
                {blog.title}
            </h3>

            <p>
                {blog.short_description}
            </p>

            <div class="read-more">

                <span>
                    Read More
                </span>

                <span class="arrow">
                    ....
                </span>

            </div>

        </div>

    </article>

</a>

<style>

.blog-link{

    display:block;

    text-decoration:none;

    color:inherit;

    height:100%;

}

.blog-card{

    background:#fff;

    border:1px solid #e5e7eb;

    border-radius:18px;

    overflow:hidden;

    display:flex;

    flex-direction:column;

    height:100%;

    transition:.35s ease;

    cursor:pointer;

}

.blog-card:hover{

    transform:translateY(-8px);

    box-shadow:0 18px 40px rgba(0,0,0,.12);

}

.image{

    height:230px;

    overflow:hidden;

    background:#f8fafc;

}

.image img{

    width:100%;

    height:100%;

    object-fit:cover;

    transition:.4s;

}

.blog-card:hover img{

    transform:scale(1.05);

}

.content{

    padding:24px;

    display:flex;

    flex-direction:column;

    flex:1;

}

.meta{

    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:18px;

}

.category{

    background:#2563eb;

    color:#fff;

    padding:6px 14px;

    border-radius:50px;

    font-size:12px;

    font-weight:700;

    text-transform:uppercase;

    letter-spacing:.4px;

}

.meta small{

    color:#64748b;

    font-size:13px;

}

h3{

    font-size:24px;

    line-height:1.35;

    margin:0 0 15px;

    color:#0f172a;

    transition:.3s;

}

.blog-card:hover h3{

    color:#2563eb;

}

p{

    color:#64748b;

    line-height:1.7;

    font-size:15px;

    flex:1;

    margin:0;

}

.read-more{

    display:flex;

    align-items:center;

    justify-content:space-between;

    margin-top:25px;

    color:#2563eb;

    font-weight:700;

    font-size:15px;

    border-top:1px solid #eef2f7;

    padding-top:18px;

}

.arrow{

    transition:.3s;

    font-size:20px;

}

.blog-card:hover .arrow{

    transform:translateX(6px);

}

@media(max-width:768px){

    .image{

        height:210px;

    }

    h3{

        font-size:20px;

    }

}

</style>