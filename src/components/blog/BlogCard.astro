---
const { blog } = Astro.props;

const image =
  blog.image && blog.image.trim() !== ""
    ? blog.image
    : "https://placehold.co/600x400?text=No+Image";

const displayDate = blog.created_at
  ? new Date(blog.created_at).toLocaleDateString("en-US", {
      day: "numeric",
      month: "short",
      year: "numeric"
    })
  : null;
---

<a
    href={`/blog/${blog.slug}`}
    class="group block w-full h-full text-inherit no-underline rounded-2xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0071AD]"
>

    <article class="flex flex-col w-full h-full bg-white border border-gray-200 rounded-2xl overflow-hidden transition-all duration-300 cursor-pointer ">

        <div class="w-full h-[210px] sm:h-[250px] overflow-hidden bg-slate-50">

            <img
                src={image}
                alt={blog.title}
                loading="lazy"
                class="w-full h-full object-cover block transition-transform duration-500 ease-out "
            />

        </div>

        <div class="flex flex-col flex-1 p-5 sm:p-7">

            <div class="flex justify-between items-center gap-2.5 mb-4 sm:mb-[18px]">

                {blog.category && (
                    <span class="bg-[#0071AD] text-white px-3.5 py-1.5 rounded-full text-[11px] sm:text-xs font-bold uppercase tracking-wide">
                        {blog.category}
                    </span>
                )}

                {displayDate && (
                    <small class="text-slate-500 text-[13px] whitespace-nowrap">
                        {displayDate}
                    </small>
                )}

            </div>

            <h3 class="mb-3 sm:mb-[15px] text-lg sm:text-[22px] leading-snug text-slate-900 font-semibold transition-colors duration-300 group-hover:text-[#0071AD] line-clamp-2">
                {blog.title}
            </h3>

            <p class="m-0 flex-1 text-slate-500 text-[15px] leading-[1.7] line-clamp-3">
                {blog.short_description}
            </p>

            <div class="flex items-center justify-between mt-6 sm:mt-7 pt-4 sm:pt-5 border-t border-slate-100">

                <span class="text-[#0071AD] text-[15px] font-bold transition-colors duration-300 group-hover:text-[#005d90]">
                    Read More
                </span>

                <span class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-[#0071AD] text-white flex items-center justify-center transition-all duration-300 shadow-[0_5px_15px_rgba(0,113,173,0.25)] group-hover:translate-x-2 group-hover:bg-[#005d90] group-hover:shadow-[0_10px_25px_rgba(0,93,144,0.35)]">

                    <span
                        class="material-symbols-outlined text-[18px] sm:text-[20px] leading-none"
                        style="font-variation-settings: 'FILL' 0, 'wght' 600, 'GRAD' 0, 'opsz' 24;"
                    >
                        arrow_forward
                    </span>

                </span>

            </div>

        </div>

    </article>

</a>