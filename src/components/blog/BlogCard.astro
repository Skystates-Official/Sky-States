---
const { blog } = Astro.props;

const image =
  blog.image && blog.image.trim() !== ""
    ? blog.image
    : "https://placehold.co/600x400?text=No+Image";
---

<a href={`/blog/${blog.slug}`} class="blog-link">

    <article class="blog-card">

        <div class="image">

            <img
                src={image}
                alt={blog.title}
                loading="lazy"
            />

        </div>

        <div class="content">

            <div class="meta">

                <span class="category">
                    {blog.category}
                </span>

                <small>
                    {new Date(blog.created_at).toLocaleDateString("en-US", {
                        day: "numeric",
                        month: "short",
                        year: "numeric"
                    })}
                </small>

            </div>

            <h3>
                {blog.title}
            </h3>

            <p>
                {blog.short_description}
            </p>

            <div class="read-more">

                <span class="read-text">
                    Read More
                </span>

                <span class="arrow-circle">

                    <span class="material-symbols-outlined">
                        arrow_forward
                    </span>

                </span>

            </div>

        </div>

    </article>

</a>



<style>
.blog-link{
    display:block;
    width:100%;
    height:100%;
    text-decoration:none;
    color:inherit;
}

.blog-card{
    width:100%;
    height:100%;
    display:flex;
    flex-direction:column;
    background:#ffffff;
    border:1px solid #e5e7eb;
    border-radius:18px;
    overflow:hidden;
    transition:all .35s ease;
    cursor:pointer;
}

.blog-card:hover{
    transform:translateY(-8px);
    box-shadow:0 18px 40px rgba(0,0,0,.12);
}

.image{
    width:100%;
    height:250px;
    overflow:hidden;
    background:#f8fafc;
}

.image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    transition:transform .4s ease;
}

.blog-card:hover img{
    transform:scale(1.05);
}

.content{
    display:flex;
    flex-direction:column;
    flex:1;
    padding:28px;
}

.meta{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
}

.category{
    background:#0071AD;
    color:#ffffff;
    padding:6px 14px;
    border-radius:999px;
    font-size:12px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.4px;
}

.meta small{
    color:#64748b;
    font-size:13px;
    white-space:nowrap;
}

h3{
    margin:0 0 15px;
    font-size:22px;
    line-height:1.4;
    color:#0f172a;
    transition:color .3s ease;
}

.blog-card:hover h3{
    color:#0071AD;
}

p{
    margin:0;
    flex:1;
    color:#64748b;
    font-size:15px;
    line-height:1.7;
}
.read-more{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-top:28px;
    padding-top:20px;
    border-top:1px solid #eef2f7;
}

.read-text{
    color:#0071AD;
    font-size:15px;
    font-weight:700;
    transition:.3s ease;
}

.arrow-circle{
    width:40px;
    height:40px;
    border-radius:50%;
    background:#0071AD;
    color:#ffffff;
    display:flex;
    align-items:center;
    justify-content:center;
    transition:all .35s ease;
    box-shadow:0 5px 15px rgba(0,113,173,.25);
}

.arrow-circle .material-symbols-outlined{
    font-size:20px;
    line-height:1;
    font-variation-settings:
        "FILL" 0,
        "wght" 600,
        "GRAD" 0,
        "opsz" 24;
}

.blog-card:hover .read-text{
    color:#005d90;
}

.blog-card:hover .arrow-circle{
    transform:translateX(8px);
    background:#005d90;
    box-shadow:0 10px 25px rgba(0,93,144,.35);
}

@media(max-width:768px){

    .image{
    height:225px;
}

    h3{
        font-size:20px;
    }

    .content{
        padding:20px;
    }

    .arrow-circle{
        width:36px;
        height:36px;
    }

    .arrow-circle .material-symbols-outlined{
        font-size:18px;
    }

}

</style>